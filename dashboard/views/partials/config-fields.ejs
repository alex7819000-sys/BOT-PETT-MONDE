<%
// Attend: groups, cfg, textChannels, categories, roles (déjà dans le scope de la page)
function renderSelect(field) {
  const current = cfg[field.key] || '';
  let options = '<option value="">— Aucun —</option>';
  if (field.type === 'channel') {
    options += textChannels.map(c => `<option value="${c.id}" ${c.id === current ? 'selected' : ''}>#${c.name}${c.isForum ? ' (forum)' : ''}</option>`).join('');
  } else if (field.type === 'category') {
    options += categories.map(c => `<option value="${c.id}" ${c.id === current ? 'selected' : ''}>📁 ${c.name}</option>`).join('');
  } else if (field.type === 'role') {
    options += roles.map(r => `<option value="${r.id}" ${r.id === current ? 'selected' : ''}>@${r.name}</option>`).join('');
  }
  return options;
}
%>
<% groups.forEach(group => { %>
  <div class="config-group">
    <div class="config-group-title"><span><%= group.icon %></span> <%= group.title %></div>
    <div class="config-fields">
      <% group.fields.forEach(field => { %>
        <div class="form-group">
          <label class="field-label"><%= field.label %></label>
          <% if (field.type === 'number') { %>
            <input type="number" name="<%= field.key %>" value="<%= cfg[field.key] !== undefined ? cfg[field.key] : '' %>">
          <% } else if (field.type === 'channels') { %>
            <input type="hidden" name="<%= field.key %>" value="">
            <div class="checkbox-grid">
              <% textChannels.forEach(c => {
                const checked = (cfg[field.key] || []).includes(c.id);
              %>
                <label class="checkbox-pill">
                  <input type="checkbox" name="<%= field.key %>" value="<%= c.id %>" <%= checked ? 'checked' : '' %>>
                  #<%= c.name %>
                </label>
              <% }) %>
            </div>
          <% } else { %>
            <select name="<%= field.key %>">
              <%- renderSelect(field) %>
            </select>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>
<% }) %>
