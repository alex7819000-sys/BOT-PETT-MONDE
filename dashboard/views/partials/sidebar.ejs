<%
const navGroups = [
  { label: 'Vue d\'ensemble', items: [
    { href: '', ic: '◆', label: 'Overview' },
  ]},
  { label: 'Configuration', items: [
    { href: '/general', ic: '👑', label: 'Général & Hiérarchie' },
    { href: '/systems', ic: '🗂️', label: 'Autres systèmes' },
  ]},
  { label: 'Modules', items: [
    { href: '/moderation', ic: '🛡️', label: 'Modération' },
    { href: '/xp', ic: '⭐', label: 'XP & Niveaux' },
    { href: '/tickets', ic: '🎫', label: 'Tickets' },
    { href: '/counting', ic: '🔢', label: 'Counting' },
    { href: '/presentations', ic: '📝', label: 'Présentations' },
    { href: '/pubs', ic: '📣', label: 'Pubs & Partenariats' },
    { href: '/staff', ic: '🏆', label: 'Classement Staff' },
  ]},
];
const base = `/dashboard/${guild.id}`;
%>
<aside class="sidebar">
  <div class="sidebar-brand">
    <span class="crown">♛</span>
    <div>
      <div class="name">KING BOT</div>
      <div class="sub">Dashboard</div>
    </div>
  </div>

  <a href="/servers" class="sidebar-guild">
    <% if (guild.icon) { %><img src="<%= guild.icon %>" alt="">
    <% } else { %><span class="ph" style="width:30px;height:30px;border-radius:50%;background:var(--elevated);display:flex;align-items:center;justify-content:center;font-size:12px;">♛</span><% } %>
    <div style="min-width:0;">
      <div class="gname"><%= guild.name %></div>
      <div class="gswitch">changer ⇄</div>
    </div>
  </a>

  <% navGroups.forEach(g => { %>
    <div class="nav-group">
      <div class="nav-label"><%= g.label %></div>
      <% g.items.forEach(it => {
        const isActive = currentPath === it.href || (it.href !== '' && currentPath.startsWith(it.href));
      %>
        <a href="<%= base + it.href %>" class="nav-item <%= isActive ? 'active' : '' %>">
          <span class="ic"><%= it.ic %></span><%= it.label %>
        </a>
      <% }) %>
    </div>
  <% }) %>

  <div class="sidebar-footer">
    <img src="<%= user.avatar %>" alt="">
    <div class="uname"><%= user.username %></div>
    <a href="/auth/logout" class="logout">Déconnexion</a>
  </div>
</aside>
