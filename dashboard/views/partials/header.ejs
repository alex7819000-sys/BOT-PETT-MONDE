<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('./head') %>
</head>
<body>
<div class="app-shell">
  <%- include('./sidebar') %>
  <main class="main">
    <%- include('./topbar') %>
    <div class="content">
      <% if (typeof saved !== 'undefined' && saved) { %>
        <div class="toast-saved">✅ Modifications enregistrées.</div>
      <% } %>
      <% if (typeof flashOk !== 'undefined' && flashOk) { %>
        <div class="toast-saved"><%= flashOk %></div>
      <% } %>
      <% if (typeof flashError !== 'undefined' && flashError) { %>
        <div class="toast-error">⚠️ <%= flashError %></div>
      <% } %>
