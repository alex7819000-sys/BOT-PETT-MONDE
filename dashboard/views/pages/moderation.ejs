<%- include('../partials/header', {pageTitle: 'Modération', pageDesc: 'Avertissements et système de ban progressif du Counting', saved: saved}) %>

<div class="section-title">🐒 Escalade des mutes — erreurs de Counting</div>
<div class="grid grid-3" style="margin-bottom:10px;">
  <% muteDurations.forEach(d => { %>
    <div class="card" style="text-align:center;">
      <div style="font-size:20px;"><%= d.emoji %></div>
      <div class="hint">Erreur #<%= d.n %></div>
      <div style="font-family:var(--font-mono);color:var(--gold-bright);font-weight:600;margin-top:2px;"><%= d.label %></div>
    </div>
  <% }) %>
</div>
<p class="field-hint" style="margin-bottom:24px;">Durées fixées dans <code>bot/src/systems/counting.js</code> (MUTE_DURATIONS). Le rôle "Singe" est attribué automatiquement à la 1ère erreur.</p>

<div class="section-title">Pires comptables (erreurs Counting)</div>
<div class="table-wrap" style="margin-bottom:30px;">
  <table>
    <thead><tr><th>Membre</th><th>Erreurs</th><th>Mute en cours</th><th></th></tr></thead>
    <tbody>
      <% if (offenders.length === 0) { %><tr><td colspan="4" class="empty-row">Personne n'a encore cassé le compte 🎉</td></tr><% } %>
      <% offenders.forEach(o => { %>
        <tr>
          <td class="user-cell"><%= o.userId %></td>
          <td><span class="badge badge-garnet"><%= o.errorCount %></span></td>
          <td><%= o.muteActive ? '<span class="badge badge-mute">🔇 actif</span>' : '—' %></td>
          <td>
            <form method="POST" action="/dashboard/<%= guild.id %>/moderation/counting/<%= o.userId %>/reset" data-confirm="Réinitialiser le compteur d'erreurs de ce membre ?">
              <button type="submit" class="btn btn-sm btn-ghost">Réinitialiser</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="section-title">🛡️ Avertissements (50 derniers)</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>Membre</th><th>Modérateur</th><th>Raison</th><th>#</th><th>Statut</th><th></th></tr></thead>
    <tbody>
      <% if (warns.length === 0) { %><tr><td colspan="6" class="empty-row">Aucun avertissement enregistré.</td></tr><% } %>
      <% warns.forEach(w => { %>
        <tr>
          <td class="user-cell"><%= w.userId %></td>
          <td class="user-cell"><%= w.moderatorId %></td>
          <td><%= w.reason %></td>
          <td><span class="badge badge-gold">#<%= w.warnNumber %></span></td>
          <td><%= w.active ? '<span class="badge badge-sage">Actif</span>' : '<span class="badge" style="color:var(--text-dim);background:var(--elevated);">Supprimé</span>' %></td>
          <td>
            <% if (w.active) { %>
              <form method="POST" action="/dashboard/<%= guild.id %>/moderation/warns/<%= w._id %>/delete" data-confirm="Supprimer cet avertissement ?">
                <button type="submit" class="btn btn-sm btn-garnet">Supprimer</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
