<%- include('../partials/header', {pageTitle: 'Présentations', pageDesc: 'Onboarding des nouveaux membres', saved: saved}) %>

<div class="grid grid-2" style="margin-bottom:26px;">
  <div class="card stat-card">
    <div class="label">Présentations terminées</div>
    <div class="value sage"><%= done %></div>
  </div>
  <div class="card stat-card">
    <div class="label">En cours</div>
    <div class="value gold"><%= inProgress.length %></div>
  </div>
</div>

<form method="POST" action="/dashboard/<%= guild.id %>/presentations" style="margin-bottom:30px;max-width:420px;">
  <div class="form-group">
    <label class="field-label">Forum de publication des présentations</label>
    <select name="presentationForumId">
      <option value="">— Aucun —</option>
      <% forums.forEach(c => { %>
        <option value="<%= c.id %>" <%= cfg.presentationForumId === c.id ? 'selected' : '' %>>🗂️ <%= c.name %></option>
      <% }) %>
    </select>
    <div class="field-hint">Doit être un salon de type Forum.</div>
  </div>
  <button type="submit" class="btn btn-gold btn-sm">💾 Enregistrer</button>
</form>

<div class="section-title">📝 Présentations en cours (non terminées)</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>Membre</th><th>Étape</th><th>Dernière mise à jour</th></tr></thead>
    <tbody>
      <% if (inProgress.length === 0) { %><tr><td colspan="3" class="empty-row">Aucune présentation en cours.</td></tr><% } %>
      <% inProgress.forEach(p => { %>
        <tr>
          <td class="user-cell"><%= p.userId %></td>
          <td><span class="badge badge-gold">Étape <%= p.step %>/3</span></td>
          <td><%= new Date(p.updatedAt).toLocaleString('fr-FR') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
