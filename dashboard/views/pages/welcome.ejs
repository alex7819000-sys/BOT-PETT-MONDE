<%- include('../partials/header', {pageTitle: 'Arrivées & Départs', pageDesc: 'Configure ton embed de bienvenue et le message court', saved: saved}) %>

<style>
/* ── Toggles ── */
.toggle{position:relative;width:44px;height:24px;flex-shrink:0}
.toggle input{opacity:0;width:0;height:0}
.slider{position:absolute;inset:0;background:#444;border-radius:24px;cursor:pointer;transition:.2s}
.slider:before{content:'';position:absolute;width:18px;height:18px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}
.toggle input:checked+.slider{background:var(--accent)}
.toggle input:checked+.slider:before{transform:translateX(20px)}
.toggle-row{display:flex;align-items:center;justify-content:space-between;background:var(--elevated);border-radius:10px;padding:14px 18px;margin-bottom:12px}
.toggle-row label{font-size:13px;color:var(--text-muted);max-width:80%}
/* ── Vars hint ── */
.vars-hint{background:#1e2124;border-radius:8px;padding:10px 14px;margin-bottom:16px;font-size:12px;color:var(--text-muted)}
.vars-hint code{background:#2b2d31;padding:1px 5px;border-radius:4px;color:#e2c97e;font-size:11px}
/* ── Embed preview ── */
.embed-preview{background:#2b2d31;border-radius:8px;padding:16px;border-left:4px solid #2ecc71;margin-top:14px}
.ep-author{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.ep-author-icon{width:24px;height:24px;border-radius:50%;background:#5865f2;object-fit:cover}
.ep-author-name{font-size:13px;font-weight:600;color:#dbdee1}
.ep-title{font-weight:700;color:#fff;font-size:15px;margin-bottom:8px}
.ep-desc{color:#dbdee1;font-size:13px;white-space:pre-wrap;line-height:1.6;margin-bottom:10px}
.ep-fields{display:grid;gap:8px;margin-bottom:10px}
.ep-field{background:#1e1f22;border-radius:6px;padding:8px 12px}
.ep-field-name{font-size:11px;font-weight:700;color:#dbdee1;margin-bottom:3px}
.ep-field-val{font-size:12px;color:#b5bac1}
.ep-thumbnail{width:80px;height:80px;border-radius:50%;object-fit:cover;flex-shrink:0;background:#5865f2}
.ep-image{max-width:100%;border-radius:6px;margin-top:10px}
.ep-footer{color:#949ba4;font-size:11px;margin-top:10px;border-top:1px solid #3a3d42;padding-top:8px;display:flex;align-items:center;gap:6px}
.ep-footer-icon{width:16px;height:16px;border-radius:50%;background:#444;object-fit:cover}
/* ── Section badge ── */
.section-badge{display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:700;vertical-align:middle;margin-left:8px}
.badge-chat{background:#5865f2;color:#fff}
.badge-bienvenue{background:#2ecc71;color:#fff}
/* ── Emoji picker ── */
.emoji-picker-wrap{position:relative;display:inline-block}
.emoji-btn{background:var(--elevated);border:1px solid var(--border);border-radius:6px;padding:5px 10px;cursor:pointer;font-size:20px;min-width:44px;text-align:center}
.emoji-picker-popup{display:none;position:absolute;z-index:999;top:calc(100% + 6px);left:0;background:#2b2d31;border:1px solid var(--border);border-radius:10px;padding:10px;width:280px;max-height:220px;overflow-y:auto;box-shadow:0 8px 24px rgba(0,0,0,.5)}
.emoji-picker-popup.open{display:block}
.emoji-picker-search{width:100%;box-sizing:border-box;background:#1e2124;border:1px solid var(--border);border-radius:6px;padding:5px 8px;color:#fff;font-size:12px;margin-bottom:8px}
.emoji-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(36px,1fr));gap:4px}
.emoji-item{width:36px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:6px;cursor:pointer;font-size:22px;transition:background .1s}
.emoji-item:hover{background:#3a3d42}
.emoji-item img{width:28px;height:28px;object-fit:contain}
/* ── Fields builder ── */
.fields-list{display:flex;flex-direction:column;gap:8px;margin-bottom:10px}
.field-row{background:#1e1f22;border-radius:8px;padding:10px 12px;display:flex;gap:8px;align-items:flex-start}
.field-row-inputs{flex:1;display:grid;grid-template-columns:1fr 1fr;gap:8px}
.field-row input{background:#2b2d31;border:1px solid var(--border);border-radius:6px;padding:5px 8px;color:#fff;font-size:12px;width:100%;box-sizing:border-box}
.field-row label{font-size:10px;color:var(--text-muted);display:block;margin-bottom:3px}
.field-row-del{background:#dc3545;border:none;color:#fff;border-radius:6px;padding:5px 8px;cursor:pointer;font-size:13px;flex-shrink:0}
.checkbox-inline{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted)}
/* ── Preview short ── */
.preview-short{background:#2b2d31;border-radius:8px;padding:12px 16px;color:#dbdee1;font-size:13.5px;margin-top:10px}
</style>

<!-- ══════════════════════════════════════════════════════
     MESSAGE COURT
════════════════════════════════════════════════════════ -->
<div class="section-title">💬 Message court <span class="section-badge badge-chat">CHAT GÉNÉRAL</span></div>
<form method="POST" action="/dashboard/<%= guild.id %>/welcome">
  <input type="hidden" name="section" value="short">
  <div class="vars-hint">
    Variables : <code>{user}</code> mention &nbsp;•&nbsp; <code>{username}</code> pseudo &nbsp;•&nbsp;
    <code>{server}</code> serveur &nbsp;•&nbsp; <code>{membercount}</code> nb membres
  </div>
  <div class="form-row">
    <div class="form-group" style="flex:1">
      <label class="field-label">Salon</label>
      <select name="welcomeChannelId" data-channel-search data-current="<%= cfg.welcomeChannelId || '' %>">
        <option value="">— Aucun —</option>
        <% textChannels.forEach(c => { %>
          <option value="<%= c.id %>" <%= cfg.welcomeChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group" style="flex:2">
      <label class="field-label">Texte</label>
      <input type="text" id="shortText" name="welcomeShortText" value="<%= cfg.welcomeShortText || '' %>" placeholder="Bienvenue {user} ! Nous sommes {membercount} membres. 🎉">
    </div>
  </div>
  <div class="preview-short" id="short-preview">Bienvenue <strong>@Nouveau</strong> ! Nous sommes <strong><%= guild.memberCount %></strong> membres. 🎉</div>
  <div style="display:flex;gap:10px;margin-top:12px;align-items:center">
    <button type="submit" class="btn btn-gold">💾 Enregistrer le message court</button>
    <button type="button" class="btn-test" onclick="sendTest('short', document.querySelector(\'[name=welcomeChannelId]\').closest(\'.cs-wrap\') ? document.querySelector(\'[name=welcomeChannelId]\').value || document.querySelector(\'.cs-wrap input[type=hidden]\').value : document.querySelector(\'[name=welcomeChannelId]\').value)">🧪 Tester</button>
  </div>
</form>

<hr style="border:none;border-top:1px solid var(--border);margin:32px 0">

<!-- ══════════════════════════════════════════════════════
     EMBED DE BIENVENUE — CONSTRUCTEUR COMPLET
════════════════════════════════════════════════════════ -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
  <div class="section-title" style="margin:0">🎉 Embed de bienvenue <span class="section-badge badge-bienvenue">SALON BIENVENUE</span></div>
  <label class="toggle">
    <input type="checkbox" id="cardToggle" <%= cfg.welcomeCardEnabled ? 'checked' : '' %> onchange="document.getElementById('card-config').style.display=this.checked?'':'none'">
    <span class="slider"></span>
  </label>
</div>
<p class="field-hint" style="margin-bottom:16px">Construis ton embed exactement comme tu le veux. Utilise les emojis de ton serveur avec le picker.</p>

<div id="card-config" style="<%= cfg.welcomeCardEnabled ? '' : 'display:none' %>">
  <form method="POST" action="/dashboard/<%= guild.id %>/welcome" id="embedForm">
    <input type="hidden" name="section" value="card">
    <input type="hidden" name="welcomeCardEnabled" value="1">
    <input type="hidden" name="welcomeFields" id="welcomeFieldsInput" value="<%= JSON.stringify(cfg.welcomeFields || []) %>">

    <div class="vars-hint">
      Variables : <code>{user}</code> mention &nbsp;•&nbsp; <code>{username}</code> pseudo &nbsp;•&nbsp;
      <code>{server}</code> serveur &nbsp;•&nbsp; <code>{membercount}</code> nb membres &nbsp;•&nbsp;
      <code>{id}</code> ID du membre
    </div>

    <!-- Salon + Couleur -->
    <div class="form-row">
      <div class="form-group" style="flex:1">
        <label class="field-label">Salon bienvenue</label>
        <select name="welcomeCardChannelId" data-channel-search data-current="<%= cfg.welcomeCardChannelId || '' %>">
          <option value="">— Aucun —</option>
          <% textChannels.forEach(c => { %>
            <option value="<%= c.id %>" <%= cfg.welcomeCardChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group" style="flex:1">
        <label class="field-label">Couleur de la barre</label>
        <div style="display:flex;gap:8px;align-items:center">
          <input type="color" name="welcomeColor" id="embedColor" value="<%= cfg.welcomeColor || '#2ecc71' %>" style="width:44px;height:36px;border:none;background:none;cursor:pointer;padding:0">
          <input type="text" id="embedColorHex" value="<%= cfg.welcomeColor || '#2ecc71' %>" placeholder="#2ecc71" style="flex:1" oninput="syncColor(this.value)">
        </div>
      </div>
    </div>

    <!-- Author -->
    <div style="background:var(--elevated);border-radius:10px;padding:14px;margin-bottom:14px">
      <div style="font-size:12px;font-weight:700;color:var(--text-muted);margin-bottom:10px">AUTEUR (ligne au-dessus du titre)</div>
      <div class="form-row">
        <div class="form-group" style="flex:2">
          <label class="field-label">Texte auteur</label>
          <div style="display:flex;gap:6px">
            <input type="text" id="embedAuthor" name="welcomeAuthor" value="<%= cfg.welcomeAuthor || '' %>" placeholder="ex: HERA 🍉 (KOUZAN)" style="flex:1">
            <div class="emoji-picker-wrap">
              <button type="button" class="emoji-btn" onclick="openPicker('authorEmojiPicker', 'embedAuthor')">😀</button>
              <div class="emoji-picker-popup" id="authorEmojiPicker"><%- emojiPickerHTML() %></div>
            </div>
          </div>
        </div>
        <div class="form-group" style="flex:1">
          <label class="field-label">Icône auteur (URL)</label>
          <input type="url" id="embedAuthorIcon" name="welcomeAuthorIcon" value="<%= cfg.welcomeAuthorIcon || '' %>" placeholder="https://... (icône ronde)">
        </div>
        <div class="form-group" style="flex:1">
          <label class="field-label">URL auteur (cliquable)</label>
          <input type="url" name="welcomeAuthorUrl" value="<%= cfg.welcomeAuthorUrl || '' %>" placeholder="https://...">
        </div>
      </div>
    </div>

    <!-- Titre -->
    <div class="form-group">
      <label class="field-label">Titre</label>
      <div style="display:flex;gap:6px">
        <input type="text" id="embedTitle" name="welcomeTitle" value="<%= cfg.welcomeTitle || '' %>" placeholder="🎉 Bienvenue sur {server} !" style="flex:1">
        <div class="emoji-picker-wrap">
          <button type="button" class="emoji-btn" onclick="openPicker('titleEmojiPicker', 'embedTitle')">😀</button>
          <div class="emoji-picker-popup" id="titleEmojiPicker"><%- emojiPickerHTML() %></div>
        </div>
      </div>
    </div>

    <!-- Description -->
    <div class="form-group">
      <label class="field-label">Description</label>
      <div style="display:flex;gap:6px;align-items:flex-start">
        <textarea id="embedDesc" name="welcomeDesc" rows="4" style="flex:1" placeholder="Hey {user}, on est ravis de t'accueillir ! 🎉&#10;&#10;Tu es le **{membercount}e** membre."><%= cfg.welcomeDesc || '' %></textarea>
        <div class="emoji-picker-wrap">
          <button type="button" class="emoji-btn" onclick="openPicker('descEmojiPicker', 'embedDesc')">😀</button>
          <div class="emoji-picker-popup" id="descEmojiPicker"><%- emojiPickerHTML() %></div>
        </div>
      </div>
    </div>

    <!-- Thumbnail + Image -->
    <div class="form-row">
      <div class="form-group" style="flex:1">
        <label class="field-label">Miniature (coin haut-droit)</label>
        <select name="welcomeThumbnail" id="embedThumb">
          <option value="avatar" <%= (cfg.welcomeThumbnail||'avatar')==='avatar' ? 'selected' : '' %>>Avatar du membre</option>
          <option value="server" <%= cfg.welcomeThumbnail==='server' ? 'selected' : '' %>>Icône du serveur</option>
          <option value="custom" <%= cfg.welcomeThumbnail==='custom' ? 'selected' : '' %>>URL personnalisée</option>
          <option value="none" <%= cfg.welcomeThumbnail==='none' ? 'selected' : '' %>>Aucune</option>
        </select>
      </div>
      <div class="form-group" style="flex:2" id="thumbUrlWrap" style="<%= cfg.welcomeThumbnail==='custom' ? '' : 'display:none' %>">
        <label class="field-label">URL de la miniature</label>
        <input type="url" name="welcomeThumbnailUrl" id="embedThumbUrl" value="<%= cfg.welcomeThumbnailUrl || '' %>" placeholder="https://...">
      </div>
    </div>

    <div class="form-group">
      <label class="field-label">Image en bas de l'embed (bannière)</label>
      <input type="url" id="embedImage" name="welcomeImage" value="<%= cfg.welcomeImage || '' %>" placeholder="https://... (image large en bas)">
    </div>

    <!-- Champs custom -->
    <div style="background:var(--elevated);border-radius:10px;padding:14px;margin-bottom:14px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
        <div style="font-size:12px;font-weight:700;color:var(--text-muted)">CHAMPS (jusqu'à 10)</div>
        <button type="button" class="btn btn-sm" onclick="addField()" style="font-size:11px;padding:4px 10px">+ Ajouter un champ</button>
      </div>
      <div class="fields-list" id="fieldsList"></div>
      <p class="field-hint" style="margin:0">Les champs Nom et Valeur supportent les variables et les emojis du serveur.</p>
    </div>

    <!-- Footer -->
    <div style="background:var(--elevated);border-radius:10px;padding:14px;margin-bottom:14px">
      <div style="font-size:12px;font-weight:700;color:var(--text-muted);margin-bottom:10px">FOOTER</div>
      <div class="form-row">
        <div class="form-group" style="flex:2">
          <label class="field-label">Texte footer</label>
          <div style="display:flex;gap:6px">
            <input type="text" id="embedFooter" name="welcomeFooter" value="<%= cfg.welcomeFooter || '' %>" placeholder="{server} • Aujourd'hui" style="flex:1">
            <div class="emoji-picker-wrap">
              <button type="button" class="emoji-btn" onclick="openPicker('footerEmojiPicker', 'embedFooter')">😀</button>
              <div class="emoji-picker-popup" id="footerEmojiPicker"><%- emojiPickerHTML() %></div>
            </div>
          </div>
        </div>
        <div class="form-group" style="flex:1">
          <label class="field-label">Icône footer (URL)</label>
          <input type="url" id="embedFooterIcon" name="welcomeFooterIcon" value="<%= cfg.welcomeFooterIcon || '' %>" placeholder="https://...">
        </div>
      </div>
      <div class="form-row" style="margin-top:8px">
        <label class="checkbox-inline">
          <input type="checkbox" name="welcomeTimestamp" <%= cfg.welcomeTimestamp ? 'checked' : '' %> id="embedTimestamp">
          Afficher la date/heure (timestamp)
        </label>
      </div>
    </div>

    <!-- Aperçu -->
    <div class="field-label" style="margin-bottom:8px">Aperçu en direct</div>
    <div class="embed-preview" id="embedPreview" style="border-left-color:<%= cfg.welcomeColor || '#2ecc71' %>">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px">
        <div style="flex:1;min-width:0">
          <div class="ep-author" id="previewAuthor" style="<%= cfg.welcomeAuthor ? '' : 'display:none' %>">
            <img class="ep-author-icon" id="previewAuthorIcon" src="<%= cfg.welcomeAuthorIcon || '' %>" onerror="this.style.display='none'" style="<%= cfg.welcomeAuthorIcon ? '' : 'display:none' %>">
            <span class="ep-author-name" id="previewAuthorName"><%= cfg.welcomeAuthor || '' %></span>
          </div>
          <div class="ep-title" id="previewTitle"><%= cfg.welcomeTitle || '🎉 Bienvenue sur ' + guild.name + ' !' %></div>
          <div class="ep-desc" id="previewDesc"><%= cfg.welcomeDesc || 'Hey @Nouveau, on est ravis de t\'accueillir parmi nous !\n\nTu es le ' + guild.memberCount + 'e membre.' %></div>
          <div class="ep-fields" id="previewFields"></div>
          <img id="previewImage" class="ep-image" src="<%= cfg.welcomeImage || '' %>" style="<%= cfg.welcomeImage ? '' : 'display:none' %>" onerror="this.style.display='none'">
          <div class="ep-footer" id="previewFooter" style="<%= (cfg.welcomeFooter||cfg.welcomeTimestamp) ? '' : 'display:none' %>">
            <img class="ep-footer-icon" id="previewFooterIcon" src="<%= cfg.welcomeFooterIcon || '' %>" style="<%= cfg.welcomeFooterIcon ? '' : 'display:none' %>" onerror="this.style.display='none'">
            <span id="previewFooterText"><%= cfg.welcomeFooter || guild.name %></span>
            <% if (cfg.welcomeTimestamp) { %><span style="margin-left:4px">• Aujourd'hui à 20:29</span><% } %>
          </div>
        </div>
        <div id="previewThumbWrap" style="<%= (cfg.welcomeThumbnail||'avatar')!=='none' ? '' : 'display:none' %>">
          <img id="previewThumb" class="ep-thumbnail"
               src="<%= cfg.welcomeThumbnail==='server' ? guild.icon : (cfg.welcomeThumbnail==='custom' ? (cfg.welcomeThumbnailUrl||'') : 'https://cdn.discordapp.com/embed/avatars/0.png') %>"
               onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
        </div>
      </div>
    </div>

    <div style="display:flex;gap:10px;margin-top:16px;align-items:center">
      <button type="submit" class="btn btn-gold" onclick="prepareSubmit()">💾 Enregistrer l'embed</button>
      <button type="button" class="btn-test" onclick="prepareSubmit();sendTest('card', document.querySelector('[name=welcomeCardChannelId]').value)">🧪 Tester l'embed</button>
    </div>
  </form>
</div>

<hr style="border:none;border-top:1px solid var(--border);margin:32px 0">

<!-- AU REVOIR -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
  <div>
    <div class="section-title" style="margin-bottom:4px">🚪 Message d'Au Revoir</div>
    <p class="field-hint" style="margin:0">Envoyé quand un membre quitte le serveur.</p>
  </div>
  <label class="toggle">
    <input type="checkbox" id="byeEnabled" <%= cfg.byeEnabled ? 'checked' : '' %> onchange="document.getElementById('bye-config').style.display=this.checked?'':'none'">
    <span class="slider"></span>
  </label>
</div>
<div id="bye-config" style="<%= cfg.byeEnabled ? '' : 'display:none' %>">
  <form method="POST" action="/dashboard/<%= guild.id %>/welcome">
    <input type="hidden" name="section" value="bye">
    <input type="hidden" name="byeEnabled" value="1">
    <div class="form-row">
      <div class="form-group" style="flex:1">
        <label class="field-label">Salon d'au revoir</label>
        <select name="byeChannelId" data-channel-search data-current="<%= cfg.byeChannelId || '' %>">
          <option value="">— Même que bienvenue —</option>
          <% textChannels.forEach(c => { %>
            <option value="<%= c.id %>" <%= cfg.byeChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group" style="flex:1">
        <label class="field-label">Couleur</label>
        <input type="text" name="byeColor" value="<%= cfg.byeColor || '#e74c3c' %>" placeholder="#e74c3c">
      </div>
    </div>
    <div class="form-group">
      <label class="field-label">Message</label>
      <textarea name="byeDesc" rows="3" placeholder="{username} a quitté le serveur. On est désormais {membercount} membres."><%= cfg.byeDesc || '' %></textarea>
    </div>
    <div style="display:flex;gap:10px;margin-top:12px;align-items:center">
      <button type="submit" class="btn btn-gold">💾 Enregistrer l'au revoir</button>
      <button type="button" class="btn-test" onclick="sendTest('bye', document.querySelector('[name=byeChannelId]').value)">🧪 Tester</button>
    </div>
  </form>
</div>

<script>
// ── Données serveur ──────────────────────────────────────────────────────────
const GUILD_NAME    = '<%= guild.name.replace(/'/g, "\\'") %>';
const GUILD_COUNT   = '<%= guild.memberCount %>';
const GUILD_ICON    = '<%= guild.icon || "" %>';

const SERVER_EMOJIS = <%- JSON.stringify(guildEmojis.map(e => ({
  id: e.id, name: e.name, animated: e.animated,
  url: `https://cdn.discordapp.com/emojis/${e.id}.${e.animated ? 'gif' : 'png'}?size=32`
}))) %>;

let embedFields = <%- JSON.stringify(cfg.welcomeFields || []) %>;

// ── Remplissage variable preview ─────────────────────────────────────────────
function fillVars(str) {
  return (str || '')
    .replace(/\{user\}/g, '@Nouveau')
    .replace(/\{username\}/g, 'Nouveau')
    .replace(/\{server\}/g, GUILD_NAME)
    .replace(/\{membercount\}/g, GUILD_COUNT)
    .replace(/\{id\}/g, '123456789012345678')
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
}

// ── Sync couleur ─────────────────────────────────────────────────────────────
function syncColor(hex) {
  if (/^#[0-9A-Fa-f]{6}$/.test(hex)) {
    document.getElementById('embedColor').value = hex;
    document.getElementById('embedPreview').style.borderLeftColor = hex;
  }
}
document.getElementById('embedColor').addEventListener('input', function() {
  document.getElementById('embedColorHex').value = this.value;
  document.getElementById('embedPreview').style.borderLeftColor = this.value;
});

// ── Emoji picker ─────────────────────────────────────────────────────────────
let currentPickerTarget = null;
function openPicker(pickerId, targetId) {
  document.querySelectorAll('.emoji-picker-popup').forEach(p => p.classList.remove('open'));
  const popup = document.getElementById(pickerId);
  currentPickerTarget = document.getElementById(targetId);
  popup.classList.add('open');
  const search = popup.querySelector('.emoji-picker-search');
  if (search) { search.value = ''; filterEmojis(search, popup); search.focus(); }
}
document.addEventListener('click', e => {
  if (!e.target.closest('.emoji-picker-wrap')) {
    document.querySelectorAll('.emoji-picker-popup').forEach(p => p.classList.remove('open'));
  }
});
function insertEmoji(text) {
  if (!currentPickerTarget) return;
  const el = currentPickerTarget;
  const start = el.selectionStart ?? el.value.length;
  const end   = el.selectionEnd   ?? el.value.length;
  el.value = el.value.slice(0, start) + text + el.value.slice(end);
  el.selectionStart = el.selectionEnd = start + text.length;
  el.dispatchEvent(new Event('input', { bubbles: true }));
  document.querySelectorAll('.emoji-picker-popup').forEach(p => p.classList.remove('open'));
}
function filterEmojis(input, popup) {
  const q = input.value.toLowerCase();
  popup.querySelectorAll('.emoji-item').forEach(item => {
    item.style.display = (!q || item.dataset.name.includes(q)) ? '' : 'none';
  });
}

// ── Champs dynamiques ────────────────────────────────────────────────────────
function renderFields() {
  const list = document.getElementById('fieldsList');
  list.innerHTML = '';
  embedFields.forEach((f, i) => {
    const div = document.createElement('div');
    div.className = 'field-row';
    div.innerHTML = `
      <div class="field-row-inputs">
        <div>
          <label>Nom du champ</label>
          <input type="text" value="${escHtml(f.name)}" oninput="embedFields[${i}].name=this.value;updatePreview()" placeholder="ex: 👤 Membre">
        </div>
        <div>
          <label>Valeur</label>
          <input type="text" value="${escHtml(f.value)}" oninput="embedFields[${i}].value=this.value;updatePreview()" placeholder="ex: {username} ({id})">
        </div>
        <label class="checkbox-inline" style="grid-column:span 2;margin-top:4px">
          <input type="checkbox" ${f.inline ? 'checked' : ''} onchange="embedFields[${i}].inline=this.checked;updatePreview()"> Inline (côte à côte)
        </label>
      </div>
      <button type="button" class="field-row-del" onclick="removeField(${i})">✕</button>`;
    list.appendChild(div);
  });
  updatePreview();
}
function addField() {
  if (embedFields.length >= 10) return alert('Maximum 10 champs.');
  embedFields.push({ name: '', value: '', inline: false });
  renderFields();
}
function removeField(i) {
  embedFields.splice(i, 1);
  renderFields();
}
function escHtml(s) { return (s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// ── Preview update ────────────────────────────────────────────────────────────
function updatePreview() {
  // Author
  const authorText = document.getElementById('embedAuthor')?.value || '';
  const authorIcon = document.getElementById('embedAuthorIcon')?.value || '';
  const previewAuthor = document.getElementById('previewAuthor');
  const previewAuthorName = document.getElementById('previewAuthorName');
  const previewAuthorIcon = document.getElementById('previewAuthorIcon');
  if (previewAuthor) previewAuthor.style.display = authorText ? '' : 'none';
  if (previewAuthorName) previewAuthorName.textContent = fillVarsText(authorText);
  if (previewAuthorIcon) { previewAuthorIcon.src = authorIcon; previewAuthorIcon.style.display = authorIcon ? '' : 'none'; }

  // Title
  const title = document.getElementById('embedTitle')?.value;
  const pt = document.getElementById('previewTitle');
  if (pt) pt.innerHTML = fillVars(title) || `🎉 Bienvenue sur ${GUILD_NAME} !`;

  // Desc
  const desc = document.getElementById('embedDesc')?.value;
  const pd = document.getElementById('previewDesc');
  if (pd) pd.innerHTML = fillVars(desc) || `Hey @Nouveau, on est ravis de t'accueillir !`;

  // Fields
  const pf = document.getElementById('previewFields');
  if (pf) {
    pf.innerHTML = '';
    pf.style.gridTemplateColumns = embedFields.some(f=>f.inline) ? 'repeat(auto-fill,minmax(140px,1fr))' : '1fr';
    embedFields.forEach(f => {
      if (!f.name && !f.value) return;
      const d = document.createElement('div');
      d.className = 'ep-field';
      d.innerHTML = `<div class="ep-field-name">${fillVarsText(f.name)}</div><div class="ep-field-val">${fillVarsText(f.value)}</div>`;
      pf.appendChild(d);
    });
  }

  // Image
  const imgUrl = document.getElementById('embedImage')?.value;
  const pi = document.getElementById('previewImage');
  if (pi) { pi.src = imgUrl || ''; pi.style.display = imgUrl ? 'block' : 'none'; }

  // Thumbnail
  const thumbMode = document.getElementById('embedThumb')?.value || 'avatar';
  const thumbUrl  = document.getElementById('embedThumbUrl')?.value || '';
  const tw = document.getElementById('previewThumbWrap');
  const pt2 = document.getElementById('previewThumb');
  if (tw) tw.style.display = thumbMode === 'none' ? 'none' : '';
  if (pt2) {
    if (thumbMode === 'avatar') pt2.src = 'https://cdn.discordapp.com/embed/avatars/0.png';
    else if (thumbMode === 'server') pt2.src = GUILD_ICON ? `https://cdn.discordapp.com/icons/${'<%= guild.id %>'}/${GUILD_ICON}.png?size=64` : '';
    else if (thumbMode === 'custom') pt2.src = thumbUrl;
  }
  // show/hide custom URL input
  const tuw = document.getElementById('thumbUrlWrap');
  if (tuw) tuw.style.display = thumbMode === 'custom' ? '' : 'none';

  // Footer
  const footerText = document.getElementById('embedFooter')?.value || '';
  const footerIcon = document.getElementById('embedFooterIcon')?.value || '';
  const timestamp  = document.getElementById('embedTimestamp')?.checked;
  const pfoot = document.getElementById('previewFooter');
  const pfootIcon = document.getElementById('previewFooterIcon');
  const pfootText = document.getElementById('previewFooterText');
  if (pfoot) pfoot.style.display = (footerText || timestamp) ? '' : 'none';
  if (pfootIcon) { pfootIcon.src = footerIcon; pfootIcon.style.display = footerIcon ? '' : 'none'; }
  if (pfootText) pfootText.textContent = fillVarsText(footerText) + (timestamp ? ' • Aujourd\'hui à 20:29' : '');
}

function fillVarsText(s) {
  return (s||'').replace(/\{user\}/g,'@Nouveau').replace(/\{username\}/g,'Nouveau')
    .replace(/\{server\}/g,GUILD_NAME).replace(/\{membercount\}/g,GUILD_COUNT).replace(/\{id\}/g,'123456789012345678');
}

// ── Soumettre avec les champs sérialisés ─────────────────────────────────────
function prepareSubmit() {
  document.getElementById('welcomeFieldsInput').value = JSON.stringify(embedFields);
}

// ── Message court preview ─────────────────────────────────────────────────────
(function() {
  const i = document.getElementById('shortText');
  const p = document.getElementById('short-preview');
  if (!i) return;
  function upd() {
    const v = i.value || 'Bienvenue {user} ! Nous sommes {membercount} membres. 🎉';
    p.innerHTML = v.replace(/\{user\}/g,'<strong>@Nouveau</strong>').replace(/\{username\}/g,'Nouveau')
      .replace(/\{server\}/g,GUILD_NAME).replace(/\{membercount\}/g,'<strong>'+GUILD_COUNT+'</strong>')
      .replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>');
  }
  i.addEventListener('input', upd); upd();
})();

// ── Init ─────────────────────────────────────────────────────────────────────
['embedAuthor','embedAuthorIcon','embedTitle','embedDesc','embedImage','embedFooter','embedFooterIcon','embedThumb','embedThumbUrl','embedTimestamp'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener('input', updatePreview), el.addEventListener('change', updatePreview);
});
renderFields();
</script>

<%
// Fonction EJS pour générer le HTML du picker d'emojis
function emojiPickerHTML() {
  let html = '<input type="text" class="emoji-picker-search" placeholder="Rechercher..." oninput="filterEmojis(this,this.closest(\'.emoji-picker-popup\'))">';
  html += '<div class="emoji-grid">';
  // Emojis unicode courants
  const common = ['😀','😂','🥰','😎','🤩','😍','🥳','🎉','🎊','✨','🔥','💥','❤️','💜','🍉','🌟','⭐','👑','🏆','💎','🦁','🐉','⚡','🌈','🎯','🛡️','⚔️','🏅','🎮','🌸'];
  common.forEach(e => {
    html += `<span class="emoji-item" data-name="${e}" onclick="insertEmoji('${e}')">${e}</span>`;
  });
  // Emojis du serveur
  if (guildEmojis && guildEmojis.length > 0) {
    html += '</div><div style="font-size:10px;color:var(--text-muted);padding:6px 2px 4px">EMOJIS DU SERVEUR</div><div class="emoji-grid">';
    guildEmojis.forEach(e => {
      const tag = e.animated ? `<a:${e.name}:${e.id}>` : `<:${e.name}:${e.id}>`;
      html += `<span class="emoji-item" data-name="${e.name}" onclick="insertEmoji('${tag}')"><img src="https://cdn.discordapp.com/emojis/${e.id}.${e.animated ? 'gif' : 'png'}?size=32" alt="${e.name}"></span>`;
    });
  }
  html += '</div>';
  return html;
}
%>


<style>
.btn-test{background:transparent;border:1px solid #5865f2;color:#5865f2;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;transition:.15s}
.btn-test:hover{background:#5865f2;color:#fff}
.test-toast{position:fixed;bottom:24px;right:24px;z-index:9999;background:#23272a;border:1px solid var(--border,#3a3d42);border-radius:10px;padding:14px 18px;display:flex;align-items:center;gap:10px;font-size:13px;color:#fff;box-shadow:0 8px 24px rgba(0,0,0,.5);transform:translateY(80px);opacity:0;transition:.3s;max-width:320px}
.test-toast.show{transform:translateY(0);opacity:1}
.test-toast.ok{border-left:4px solid #2ecc71}
.test-toast.err{border-left:4px solid #e74c3c}
.test-toast .tt-icon{font-size:20px;flex-shrink:0}
</style>
<div class="test-toast" id="testToast">
  <span class="tt-icon" id="testToastIcon">🧪</span>
  <span id="testToastMsg">Message envoyé !</span>
</div>
<script>
async function sendTest(type, channelId) {
  if (!channelId) {
    showToast('❌', 'Sélectionne d\'abord un salon.', false);
    return;
  }
  showToast('⏳', 'Envoi en cours...', null);
  try {
    const r = await fetch('/dashboard/<%= guild.id %>/test', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type, channelId }),
    });
    const d = await r.json();
    if (d.ok) showToast('✅', d.msg || 'Envoyé !', true);
    else showToast('❌', d.error || 'Erreur', false);
  } catch(e) {
    showToast('❌', 'Erreur réseau', false);
  }
}
function showToast(icon, msg, ok) {
  const t = document.getElementById('testToast');
  document.getElementById('testToastIcon').textContent = icon;
  document.getElementById('testToastMsg').textContent  = msg;
  t.className = 'test-toast show' + (ok === true ? ' ok' : ok === false ? ' err' : '');
  clearTimeout(t._hide);
  if (ok !== null) t._hide = setTimeout(() => t.classList.remove('show'), 3500);
}
</script>

