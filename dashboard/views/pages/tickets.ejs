<%- include('../partials/header', {pageTitle: 'Tickets', pageDesc: 'Support, signalements, partenariats — ouverts et historique', saved: saved, flashError: flashError}) %>

<form method="POST" action="/dashboard/<%= guild.id %>/tickets" style="margin-bottom:30px;max-width:520px;">
  <div class="form-group">
    <label class="field-label">Catégorie de création des tickets</label>
    <select name="ticketCategoryId">
      <option value="">— Aucune —</option>
      <% categories.forEach(c => { %>
        <option value="<%= c.id %>" <%= cfg.ticketCategoryId === c.id ? 'selected' : '' %>>📁 <%= c.name %></option>
      <% }) %>
    </select>
  </div>
  <div class="section-title" style="margin-top:18px;">🛡️ Protection anti-spam</div>
  <p class="field-hint" style="margin:0 0 10px;">Champ vide = valeur par défaut. Mets <b>0</b> pour désactiver une limite. Le staff n'est jamais limité.</p>
  <div class="form-group">
    <label class="field-label">Tickets ouverts max par membre (défaut : 3)</label>
    <input type="number" name="ticketMaxOpen" min="0" max="1000" value="<%= cfg.ticketMaxOpen != null ? cfg.ticketMaxOpen : '' %>" placeholder="3">
  </div>
  <div class="form-group">
    <label class="field-label">Délai avant de rouvrir un ticket, en minutes (défaut : 10)</label>
    <input type="number" name="ticketCooldownMin" min="0" max="1000" value="<%= cfg.ticketCooldownMin != null ? cfg.ticketCooldownMin : '' %>" placeholder="10">
  </div>
  <div class="form-group">
    <label class="field-label">Délai après un refus de partenariat / candidature, en jours (défaut : 7)</label>
    <input type="number" name="ticketRefusalDays" min="0" max="1000" value="<%= cfg.ticketRefusalDays != null ? cfg.ticketRefusalDays : '' %>" placeholder="7">
  </div>
  <button type="submit" class="btn btn-gold btn-sm">💾 Enregistrer</button>
</form>

<div class="section-title">🚫 Membres bloqués des tickets</div>
<p class="field-hint" style="margin:0 0 10px;">Un membre est bloqué automatiquement après 3 tickets fermés avec le motif « Spam ».</p>
<div class="table-wrap" style="margin-bottom:14px;">
  <table>
    <thead><tr><th>Membre</th><th>Avertissements spam</th><th>État</th><th></th></tr></thead>
    <tbody>
      <% if (blocks.length === 0) { %><tr><td colspan="4" class="empty-row">Personne n'est bloqué.</td></tr><% } %>
      <% blocks.forEach(k => { %>
        <tr>
          <td class="user-cell"><%- who(k.userId) %></td>
          <td><%= k.strikes || 0 %> / 3</td>
          <td><% if (k.blocked) { %><span class="badge badge-garnet">Bloqué</span><% } else { %>—<% } %></td>
          <td>
            <form method="POST" action="/dashboard/<%= guild.id %>/tickets" style="margin:0;">
              <input type="hidden" name="section" value="unblock">
              <input type="hidden" name="userId" value="<%= k.userId %>">
              <button type="submit" class="btn btn-sm btn-ghost">Débloquer / remettre à 0</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<form method="POST" action="/dashboard/<%= guild.id %>/tickets" style="margin-bottom:30px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
  <input type="hidden" name="section" value="block">
  <input type="text" name="userId" placeholder="ID Discord du membre à bloquer" inputmode="numeric" pattern="[0-9]{17,20}" required style="max-width:300px;">
  <button type="submit" class="btn btn-sm btn-ghost">🚫 Bloquer des tickets</button>
</form>

<div class="section-title">🎫 Tickets ouverts (<%= openTickets.length %>)</div>
<div class="table-wrap" style="margin-bottom:30px;">
  <table>
    <thead><tr><th>Membre</th><th>Type</th><th>Pris en charge par</th><th>Ouvert le</th></tr></thead>
    <tbody>
      <% if (openTickets.length === 0) { %><tr><td colspan="4" class="empty-row">Aucun ticket ouvert. 🎉</td></tr><% } %>
      <% openTickets.forEach(t => { %>
        <tr>
          <td class="user-cell"><%- who(t.userId) %></td>
          <td><span class="badge badge-gold"><%= t.type %></span></td>
          <td class="user-cell"><%- t.claimedBy ? who(t.claimedBy) : '— en attente —' %></td>
          <td><%= new Date(t.createdAt).toLocaleString('fr-FR') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="section-title">📁 Historique (30 derniers fermés)</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>Membre</th><th>Type</th><th>Fermé par</th><th>Fermé le</th></tr></thead>
    <tbody>
      <% if (closedTickets.length === 0) { %><tr><td colspan="4" class="empty-row">Aucun ticket fermé encore.</td></tr><% } %>
      <% closedTickets.forEach(t => { %>
        <tr>
          <td class="user-cell"><%- who(t.userId) %></td>
          <td><%= t.type %></td>
          <td class="user-cell"><%- who(t.closedBy) %></td>
          <td><%= t.closedAt ? new Date(t.closedAt).toLocaleString('fr-FR') : '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
