<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('../partials/head', {pageTitle: 'Tes serveurs'}) %>
</head>
<body>
  <div class="content" style="max-width:920px;margin:0 auto;">
    <div class="page-header" style="margin-top:40px;display:flex;align-items:center;justify-content:space-between;">
      <div>
        <h2>♛ Choisis ton serveur</h2>
        <p>Serveurs Discord où King Bot est présent et où tu es administrateur.</p>
      </div>
      <a href="/auth/logout" class="muted-link">Déconnexion</a>
    </div>

    <% if (managed.length === 0) { %>
      <div class="card empty-row">
        Aucun serveur géré pour l'instant. Invite King Bot sur un serveur où tu es administrateur, puis recharge cette page.
      </div>
    <% } else { %>
      <div class="server-grid">
        <% managed.forEach(g => { %>
          <a href="/dashboard/<%= g.id %>" class="server-card">
            <% if (g.icon) { %><img src="<%= g.icon %>" alt=""><% } else { %><span class="ph">♛</span><% } %>
            <div class="sname"><%= g.name %></div>
            <span class="badge badge-gold">Gérer →</span>
          </a>
        <% }) %>
      </div>
    <% } %>

    <% if (other.length > 0) { %>
      <div class="section-title">Autres serveurs</div>
      <div class="server-grid">
        <% other.forEach(g => { %>
          <div class="server-card locked">
            <% if (g.icon) { %><img src="<%= g.icon %>" alt=""><% } else { %><span class="ph">♛</span><% } %>
            <div class="sname"><%= g.name %></div>
            <span class="muted-link"><%= g.hasBot ? 'Droits insuffisants' : 'King Bot absent' %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>
