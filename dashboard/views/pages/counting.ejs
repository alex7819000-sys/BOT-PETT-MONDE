<%- include('../partials/header', {pageTitle: 'Counting', pageDesc: 'Salon de comptage et suivi des erreurs', saved: saved}) %>

<div class="grid grid-2" style="margin-bottom:26px;">
  <div class="card stat-card">
    <div class="label">Compte actuel</div>
    <div class="value gold"><%= cfg.countingCurrent || 0 %></div>
  </div>
  <div class="card stat-card">
    <div class="label">Meilleur streak historique</div>
    <div class="value sage"><%= cfg.countingBestStreak || 0 %></div>
  </div>
</div>

<form method="POST" action="/dashboard/<%= guild.id %>/counting" style="margin-bottom:18px;max-width:420px;">
  <div class="form-group">
    <label class="field-label">Salon de Counting</label>
    <select name="countingChannelId" data-channel-search data-current="<%= cfg.countingChannelId || '' %>">
      <option value="">— Aucun —</option>
      <% textChannels.forEach(c => { %>
        <option value="<%= c.id %>" <%= cfg.countingChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
      <% }) %>
    </select>
  </div>
  <button type="submit" class="btn btn-gold btn-sm">💾 Enregistrer</button>
</form>

<form method="POST" action="/dashboard/<%= guild.id %>/counting/reset-count" data-confirm="Remettre le compte à 0 ?" style="margin-bottom:30px;">
  <button type="submit" class="btn btn-garnet btn-sm">↺ Remettre le compte à 0</button>
</form>

<div class="section-title">🐒 Pires comptables</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>Membre</th><th>Erreurs</th><th>Mute en cours</th><th></th></tr></thead>
    <tbody>
      <% if (offenders.length === 0) { %><tr><td colspan="4" class="empty-row">Personne n'a encore cassé le compte 🎉</td></tr><% } %>
      <% offenders.forEach(o => { %>
        <tr>
          <td class="user-cell"><%= o.userId %></td>
          <td><span class="badge badge-garnet"><%= o.errorCount %></span></td>
          <td><%= o.muteActive ? '<span class="badge badge-mute">🔇 actif</span>' : '—' %></td>
          <td>
            <form method="POST" action="/dashboard/<%= guild.id %>/moderation/counting/<%= o.userId %>/reset" data-confirm="Réinitialiser le compteur d'erreurs de ce membre ?">
              <button type="submit" class="btn btn-sm btn-ghost">Réinitialiser</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
