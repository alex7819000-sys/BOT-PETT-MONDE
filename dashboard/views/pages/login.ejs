<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('../partials/head', {pageTitle: 'Connexion'}) %>
</head>
<body>
  <div class="login-shell">
    <div class="login-card">
      <div class="login-crown">♛</div>
      <h1>KING BOT</h1>
      <p class="tag">Tableau de bord — gère ton serveur Discord</p>

      <% if (error) { %>
        <div class="login-error">
          <% if (error === 'oauth') { %>Échec de la connexion Discord. Réessaie.<% } else { %>Connexion annulée.<% } %>
        </div>
      <% } %>

      <a href="/auth/discord" class="btn btn-discord">
        <span>🔒</span> Se connecter avec Discord
      </a>
    </div>
  </div>
</body>
</html>
