<%- include('../partials/header', {pageTitle: 'Général & Hiérarchie', pageDesc: 'Salons système, rôles de hiérarchie et paramètres globaux', saved: saved}) %>

<form method="POST" action="/dashboard/<%= guild.id %>/general">
  <%- include('../partials/config-fields', { groups, cfg, textChannels, categories, roles }) %>

  <div class="config-group">
    <div class="config-group-title">🤝 Co-Owners</div>
    <div class="form-group">
      <label class="field-label">IDs Discord des co-owners (séparés par des virgules)</label>
      <input type="text" name="coOwnerIds" value="<%= (cfg.coOwnerIds || []).join(', ') %>" placeholder="123456789012345678, 987654321098765432">
      <div class="field-hint">Clic droit sur un membre → Copier l'identifiant (active le mode développeur dans Discord pour voir cette option).</div>
    </div>
  </div>

  <button type="submit" class="btn btn-gold">💾 Enregistrer les modifications</button>
</form>

<%- include('../partials/footer') %>
