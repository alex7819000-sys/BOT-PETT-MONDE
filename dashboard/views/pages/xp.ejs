<%- include('../partials/header', {pageTitle: 'XP & Niveaux', pageDesc: 'Réglages du gain d\'XP et classement des membres', saved: saved}) %>

<div class="section-title">🚀 Bump (Disboard)</div>
<form method="POST" action="/dashboard/<%= guild.id %>/xp" id="bump-form" style="margin-bottom:34px;">
  <div class="form-row">
    <div class="form-group">
      <label class="field-label">XP donné par bump réussi</label>
      <input type="number" name="bumpXpReward" value="<%= cfg.bumpXpReward ?? 500 %>">
      <div class="field-hint">Détecté automatiquement quand quelqu'un fait /bump avec Disboard.</div>
    </div>
    <div class="form-group">
      <label class="field-label">Salon où poster le remerciement</label>
      <select name="bumpChannelId">
        <option value="">— Salon où le bump a été fait —</option>
        <% textChannels.forEach(c => { %>
          <option value="<%= c.id %>" <%= cfg.bumpChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div class="config-group-title" style="margin-top:18px;">🎨 Embed de remerciement (personnalisable)</div>
  <p class="field-hint" style="margin-bottom:14px;">
    Variables disponibles : <code>{user}</code> (mention), <code>{username}</code>, <code>{xp}</code>, <code>{totalBumps}</code>, <code>{servername}</code>
  </p>
  <div class="form-row">
    <div class="form-group">
      <label class="field-label">Titre</label>
      <input type="text" id="bumpEmbedTitle" name="bumpEmbedTitle" value="<%= cfg.bumpEmbedTitle || '' %>" placeholder="🚀 Bump effectué !">
    </div>
    <div class="form-group">
      <label class="field-label">Couleur (hex)</label>
      <input type="text" id="bumpEmbedColor" name="bumpEmbedColor" value="<%= cfg.bumpEmbedColor || '#00D165' %>" placeholder="#00D165">
    </div>
  </div>
  <div class="form-group">
    <label class="field-label">Description</label>
    <textarea id="bumpEmbedDescription" name="bumpEmbedDescription" placeholder="Merci {user} pour le bump ! Tu gagnes **{xp} XP** 🎉"><%= cfg.bumpEmbedDescription || '' %></textarea>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label class="field-label">Image (bannière, URL)</label>
      <input type="url" id="bumpEmbedImageUrl" name="bumpEmbedImageUrl" value="<%= cfg.bumpEmbedImageUrl || '' %>" placeholder="https://...">
    </div>
    <div class="form-group">
      <label class="field-label">Footer</label>
      <input type="text" id="bumpEmbedFooter" name="bumpEmbedFooter" value="<%= cfg.bumpEmbedFooter || '' %>" placeholder="Merci {username} !">
    </div>
  </div>
  <input type="hidden" name="bumpEmbedThumbnailUrl" value="<%= cfg.bumpEmbedThumbnailUrl || '' %>">

  <div class="field-label" style="margin-top:18px;margin-bottom:8px;">Aperçu en direct</div>
  <div style="background:#2b2d31;border-radius:8px;padding:14px 16px;border-left:4px solid #00D165;max-width:480px;" id="bump-preview">
    <div id="preview-title" style="font-weight:700;color:#fff;font-size:14px;margin-bottom:4px;">🚀 Bump effectué !</div>
    <div id="preview-desc" style="color:#dbdee1;font-size:13.5px;white-space:pre-wrap;">Merci @Bumpeur pour le bump ! Tu gagnes **500 XP** 🎉</div>
    <img id="preview-img" style="max-width:100%;border-radius:6px;margin-top:8px;display:none;">
    <div id="preview-footer" style="color:#949ba4;font-size:11px;margin-top:8px;display:none;"></div>
  </div>

  <button type="submit" class="btn btn-gold" style="margin-top:18px;">💾 Enregistrer</button>
</form>

<script>
(function () {
  const $ = (id) => document.getElementById(id);
  const fill = (str) => (str || '')
    .replace(/\{user\}/g, '@Bumpeur')
    .replace(/\{username\}/g, 'Bumpeur')
    .replace(/\{xp\}/g, '<%= cfg.bumpXpReward ?? 500 %>')
    .replace(/\{totalBumps\}/g, '12')
    .replace(/\{servername\}/g, '<%= guild.name %>');

  function update() {
    $('preview-title').textContent = fill($('bumpEmbedTitle').value) || '🚀 Bump effectué !';
    $('preview-desc').textContent = fill($('bumpEmbedDescription').value) || 'Merci @Bumpeur pour le bump ! Tu gagnes **500 XP** 🎉';
    const color = $('bumpEmbedColor').value || '#00D165';
    document.getElementById('bump-preview').style.borderLeftColor = /^#[0-9A-Fa-f]{6}$/.test(color) ? color : '#00D165';
    const img = $('bumpEmbedImageUrl').value;
    if (img) { $('preview-img').src = img; $('preview-img').style.display = 'block'; } else { $('preview-img').style.display = 'none'; }
    const footer = fill($('bumpEmbedFooter').value);
    if (footer) { $('preview-footer').textContent = footer; $('preview-footer').style.display = 'block'; } else { $('preview-footer').style.display = 'none'; }
  }
  ['bumpEmbedTitle', 'bumpEmbedDescription', 'bumpEmbedColor', 'bumpEmbedImageUrl', 'bumpEmbedFooter'].forEach((id) => {
    $(id).addEventListener('input', update);
  });
  update();
})();
</script>

<div class="section-title">⚙️ Réglages XP message</div>
<form method="POST" action="/dashboard/<%= guild.id %>/xp" style="margin-bottom:34px;">
  <div class="form-row">
    <div class="form-group">
      <label class="field-label">XP par message</label>
      <input type="number" name="xpPerMessage" value="<%= cfg.xpPerMessage ?? 15 %>">
    </div>
    <div class="form-group">
      <label class="field-label">Cooldown entre deux gains (secondes)</label>
      <input type="number" name="xpCooldown" value="<%= cfg.xpCooldown ?? 60 %>">
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label class="field-label">Salon du classement (/rank)</label>
      <select name="rankChannelId">
        <option value="">— Aucun —</option>
        <% textChannels.forEach(c => { %>
          <option value="<%= c.id %>" <%= cfg.rankChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group">
      <label class="field-label">Salon des notifications "Level Up"</label>
      <select name="levelUpChannelId">
        <option value="">— Utiliser le salon de classement —</option>
        <% textChannels.forEach(c => { %>
          <option value="<%= c.id %>" <%= cfg.levelUpChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
        <% }) %>
      </select>
      <div class="field-hint">Si vide, les notifications utilisent le salon de classement, sinon le salon où le membre a écrit.</div>
    </div>
  </div>
  <button type="submit" class="btn btn-gold">💾 Enregistrer</button>
</form>

<div class="section-title">🏆 Classement (top 50)</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>#</th><th>Membre</th><th>Niveau</th><th>XP total</th><th>Messages</th></tr></thead>
    <tbody>
      <% if (leaderboard.length === 0) { %><tr><td colspan="5" class="empty-row">Aucune donnée XP encore.</td></tr><% } %>
      <% leaderboard.forEach((u, i) => { %>
        <tr>
          <td class="rank-pos">#<%= i + 1 %></td>
          <td class="user-cell"><%= u.username || u.userId %></td>
          <td><span class="badge badge-gold">Niv. <%= u.level %></span></td>
          <td><%= u.totalXp.toLocaleString('fr-FR') %></td>
          <td><%= u.messageCount.toLocaleString('fr-FR') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
