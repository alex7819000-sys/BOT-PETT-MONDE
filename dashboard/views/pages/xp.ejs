<%- include('../partials/header', {pageTitle: 'XP & Niveaux', pageDesc: 'Réglages du gain d\'XP et classement des membres', saved: saved}) %>

<div class="section-title">🚀 Bump (Disboard)</div>
<form method="POST" action="/dashboard/<%= guild.id %>/xp" id="bump-form" style="margin-bottom:34px;">
  <div class="form-row">
    <div class="form-group">
      <label class="field-label">XP donné par bump réussi</label>
      <input type="number" name="bumpXpReward" value="<%= cfg.bumpXpReward ?? 500 %>">
      <div class="field-hint">Détecté automatiquement quand quelqu'un fait /bump avec Disboard.</div>
    </div>
    <div class="form-group">
      <label class="field-label">Salon où poster le remerciement</label>
      <select name="bumpChannelId">
        <option value="">— Salon où le bump a été fait —</option>
        <% textChannels.forEach(c => { %>
          <option value="<%= c.id %>" <%= cfg.bumpChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div class="config-group-title" style="margin-top:18px;">🎨 Embed de remerciement (personnalisable)</div>
  <p class="field-hint" style="margin-bottom:14px;">
    Variables disponibles : <code>{user}</code> (mention), <code>{username}</code>, <code>{xp}</code>, <code>{totalBumps}</code>, <code>{servername}</code>
  </p>
  <div class="form-row">
    <div class="form-group">
      <label class="field-label">Titre</label>
      <input type="text" id="bumpEmbedTitle" name="bumpEmbedTitle" value="<%= cfg.bumpEmbedTitle || '' %>" placeholder="🚀 Bump effectué !">
    </div>
    <div class="form-group">
      <label class="field-label">Couleur (hex)</label>
      <input type="text" id="bumpEmbedColor" name="bumpEmbedColor" value="<%= cfg.bumpEmbedColor || '#00D165' %>" placeholder="#00D165">
    </div>
  </div>
  <div class="form-group">
    <label class="field-label">Description</label>
    <textarea id="bumpEmbedDescription" name="bumpEmbedDescription" placeholder="Merci {user} pour le bump ! Tu gagnes **{xp} XP** 🎉"><%= cfg.bumpEmbedDescription || '' %></textarea>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label class="field-label">Image (bannière, URL)</label>
      <input type="url" id="bumpEmbedImageUrl" name="bumpEmbedImageUrl" value="<%= cfg.bumpEmbedImageUrl || '' %>" placeholder="https://...">
    </div>
    <div class="form-group">
      <label class="field-label">Footer</label>
      <input type="text" id="bumpEmbedFooter" name="bumpEmbedFooter" value="<%= cfg.bumpEmbedFooter || '' %>" placeholder="Merci {username} !">
    </div>
  </div>
  <input type="hidden" name="bumpEmbedThumbnailUrl" value="<%= cfg.bumpEmbedThumbnailUrl || '' %>">

  <div class="field-label" style="margin-top:18px;margin-bottom:8px;">Aperçu en direct</div>
  <div style="background:#2b2d31;border-radius:8px;padding:14px 16px;border-left:4px solid #00D165;max-width:480px;" id="bump-preview">
    <div id="preview-title" style="font-weight:700;color:#fff;font-size:14px;margin-bottom:4px;">🚀 Bump effectué !</div>
    <div id="preview-desc" style="color:#dbdee1;font-size:13.5px;white-space:pre-wrap;">Merci @Bumpeur pour le bump ! Tu gagnes **500 XP** 🎉</div>
    <img id="preview-img" style="max-width:100%;border-radius:6px;margin-top:8px;display:none;">
    <div id="preview-footer" style="color:#949ba4;font-size:11px;margin-top:8px;display:none;"></div>
  </div>

  <button type="submit" class="btn btn-gold" style="margin-top:18px;">💾 Enregistrer</button>
</form>

<script>
(function () {
  const $ = (id) => document.getElementById(id);
  const fill = (str) => (str || '')
    .replace(/\{user\}/g, '@Bumpeur')
    .replace(/\{username\}/g, 'Bumpeur')
    .replace(/\{xp\}/g, '<%= cfg.bumpXpReward ?? 500 %>')
    .replace(/\{totalBumps\}/g, '12')
    .replace(/\{servername\}/g, '<%= guild.name %>');

  function update() {
    $('preview-title').textContent = fill($('bumpEmbedTitle').value) || '🚀 Bump effectué !';
    $('preview-desc').textContent = fill($('bumpEmbedDescription').value) || 'Merci @Bumpeur pour le bump ! Tu gagnes **500 XP** 🎉';
    const color = $('bumpEmbedColor').value || '#00D165';
    document.getElementById('bump-preview').style.borderLeftColor = /^#[0-9A-Fa-f]{6}$/.test(color) ? color : '#00D165';
    const img = $('bumpEmbedImageUrl').value;
    if (img) { $('preview-img').src = img; $('preview-img').style.display = 'block'; } else { $('preview-img').style.display = 'none'; }
    const footer = fill($('bumpEmbedFooter').value);
    if (footer) { $('preview-footer').textContent = footer; $('preview-footer').style.display = 'block'; } else { $('preview-footer').style.display = 'none'; }
  }
  ['bumpEmbedTitle', 'bumpEmbedDescription', 'bumpEmbedColor', 'bumpEmbedImageUrl', 'bumpEmbedFooter'].forEach((id) => {
    $(id).addEventListener('input', update);
  });
  update();
})();
</script>

<div class="section-title">⚙️ Réglages XP message</div>
<form method="POST" action="/dashboard/<%= guild.id %>/xp" style="margin-bottom:34px;">
  <div class="form-row">
    <div class="form-group">
      <label class="field-label">XP par message</label>
      <input type="number" name="xpPerMessage" value="<%= cfg.xpPerMessage ?? 15 %>">
    </div>
    <div class="form-group">
      <label class="field-label">Cooldown entre deux gains (secondes)</label>
      <input type="number" name="xpCooldown" value="<%= cfg.xpCooldown ?? 60 %>">
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label class="field-label">Salon du classement (/rank)</label>
      <select name="rankChannelId">
        <option value="">— Aucun —</option>
        <% textChannels.forEach(c => { %>
          <option value="<%= c.id %>" <%= cfg.rankChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group">
      <label class="field-label">Salon des notifications "Level Up"</label>
      <select name="levelUpChannelId">
        <option value="">— Utiliser le salon de classement —</option>
        <% textChannels.forEach(c => { %>
          <option value="<%= c.id %>" <%= cfg.levelUpChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
        <% }) %>
      </select>
      <div class="field-hint">Si vide, les notifications utilisent le salon de classement, sinon le salon où le membre a écrit.</div>
    </div>
  </div>
  <button type="submit" class="btn btn-gold">💾 Enregistrer</button>
</form>

<!-- ── RÉCOMPENSES DE NIVEAUX ──────────────────────────────── -->
<hr style="border:none;border-top:1px solid var(--border);margin:28px 0;">

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
  <div>
    <div class="section-title" style="margin-bottom:4px;">🎁 Récompenses de Niveaux</div>
    <p class="field-hint" style="margin:0;">Attribuez automatiquement un rôle quand un membre atteint un niveau.</p>
  </div>
  <button class="btn btn-gold" onclick="openRewardModal()" type="button">+ Créer une récompense</button>
</div>

<style>
.reward-list { display:flex; flex-direction:column; gap:8px; margin-bottom:24px; }
.reward-item { display:flex; align-items:center; justify-content:space-between; background:var(--elevated); border-radius:10px; padding:14px 18px; }
.reward-item-left { display:flex; flex-direction:column; gap:3px; }
.reward-item-level { font-size:13px; font-weight:700; color:var(--accent); }
.reward-item-role { font-size:12px; color:var(--text-muted); }
.reward-item-type { font-size:11px; padding:2px 8px; border-radius:20px; font-weight:600; }
.reward-item-type.stackable { background:rgba(37,204,102,0.15); color:#25cc66; }
.reward-item-type.evolve { background:rgba(229,77,46,0.15); color:#e54d2e; }
.reward-item-actions { display:flex; gap:8px; align-items:center; }
.btn-sm { padding:5px 14px; font-size:12px; border-radius:6px; border:none; cursor:pointer; font-weight:600; }
.btn-edit { background:var(--elevated); color:var(--text); border:1px solid var(--border); }
.btn-edit:hover { background:var(--accent); color:#000; }
.btn-delete { background:transparent; color:#da373c; border:1px solid rgba(218,55,60,0.3); }
.btn-delete:hover { background:#da373c; color:#fff; }

/* Modal */
.modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:1000; display:none; align-items:center; justify-content:center; }
.modal-overlay.open { display:flex; }
.modal-box { background:var(--surface); border-radius:14px; padding:28px; width:100%; max-width:480px; box-shadow:0 20px 60px rgba(0,0,0,0.5); }
.modal-title { font-size:16px; font-weight:700; color:var(--text); margin-bottom:20px; }
.modal-actions { display:flex; justify-content:space-between; margin-top:24px; gap:10px; }
.reward-type-row { display:flex; gap:10px; margin-bottom:4px; }
.reward-type-card { flex:1; border:2px solid var(--border); border-radius:10px; padding:12px; cursor:pointer; transition:.15s; }
.reward-type-card.selected { border-color:var(--accent); background:rgba(226,201,126,0.08); }
.reward-type-card h4 { font-size:13px; font-weight:700; margin:0 0 4px; color:var(--text); }
.reward-type-card p { font-size:11px; color:var(--text-muted); margin:0; line-height:1.4; }
</style>

<!-- Liste des récompenses -->
<div class="reward-list">
  <% if (!cfg.levelRoles || cfg.levelRoles.length === 0) { %>
    <div style="text-align:center;padding:24px;color:var(--text-muted);font-size:13px;background:var(--elevated);border-radius:10px;">
      Aucune récompense configurée. Cliquez sur "+ Créer une récompense" pour commencer.
    </div>
  <% } %>
  <% (cfg.levelRoles || []).sort((a,b) => b.level - a.level).forEach(r => {
    const roleName = (roles || []).find(x => x.id === r.roleId);
  %>
    <div class="reward-item">
      <div class="reward-item-left">
        <span class="reward-item-level">Niveau <%= r.level %></span>
        <span class="reward-item-role">@<%= roleName ? roleName.name : r.roleId %></span>
      </div>
      <div class="reward-item-actions">
        <span class="reward-item-type <%= r.stackable ? 'stackable' : 'evolve' %>">
          <%= r.stackable ? '🔗 Cumulable' : '🔄 Évolutif' %>
        </span>
        <button class="btn-sm btn-edit" type="button"
          onclick="openRewardModal({ level: <%= r.level %>, roleId: '<%= r.roleId %>', stackable: <%= !!r.stackable %> })">
          Modifier
        </button>
        <form method="POST" action="/dashboard/<%= guild.id %>/xp/level-rewards/delete" style="margin:0;" onsubmit="return confirm('Supprimer cette récompense ?')">
          <input type="hidden" name="level" value="<%= r.level %>">
          <button class="btn-sm btn-delete" type="submit">Supprimer</button>
        </form>
      </div>
    </div>
  <% }) %>
</div>

<!-- Modal création/édition -->
<div class="modal-overlay" id="reward-modal">
  <div class="modal-box">
    <div class="modal-title">🎁 Édition d'une récompense</div>
    <form method="POST" id="reward-form" action="/dashboard/<%= guild.id %>/xp/level-rewards/add">
      <div class="form-row">
        <div class="form-group">
          <label class="field-label">Niveau requis</label>
          <input type="number" name="level" id="rw-level" min="1" max="999" placeholder="10" required>
        </div>
        <div class="form-group">
          <label class="field-label">Rôle à attribuer</label>
          <select name="roleId" id="rw-role" required>
            <option value="">— Choisir un rôle —</option>
            <% (roles || []).forEach(r => { %>
              <option value="<%= r.id %>">@<%= r.name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <label class="field-label" style="margin-bottom:10px;display:block;">Gestion du rôle</label>
      <div class="reward-type-row">
        <div class="reward-type-card" id="card-stackable" onclick="selectType(true)">
          <h4>🔗 Rôle Cumulable</h4>
          <p>Les rôles cumulables sont conservés lorsque l'utilisateur reçoit un nouveau rôle.</p>
        </div>
        <div class="reward-type-card selected" id="card-evolve" onclick="selectType(false)">
          <h4>🔄 Rôle Évolutif</h4>
          <p>Les rôles évolutifs se succèdent, remplaçant le précédent à chaque nouveau rôle.</p>
        </div>
      </div>
      <input type="hidden" name="stackable" id="rw-stackable" value="false">

      <div class="modal-actions">
        <button type="button" class="btn" onclick="closeRewardModal()" style="background:var(--elevated);color:var(--text);">Annuler</button>
        <button type="submit" class="btn btn-gold">Enregistrer</button>
      </div>
    </form>
  </div>
</div>

<script>
function openRewardModal(data) {
  const modal = document.getElementById('reward-modal');
  modal.classList.add('open');
  if (data) {
    document.getElementById('rw-level').value = data.level;
    document.getElementById('rw-role').value = data.roleId;
    selectType(data.stackable);
  } else {
    document.getElementById('rw-level').value = '';
    document.getElementById('rw-role').value = '';
    selectType(false);
  }
}
function closeRewardModal() {
  document.getElementById('reward-modal').classList.remove('open');
}
function selectType(stackable) {
  document.getElementById('rw-stackable').value = stackable ? 'true' : 'false';
  document.getElementById('card-stackable').classList.toggle('selected', stackable);
  document.getElementById('card-evolve').classList.toggle('selected', !stackable);
}
document.getElementById('reward-modal').addEventListener('click', function(e) {
  if (e.target === this) closeRewardModal();
});
</script>

<!-- ── CLASSEMENT ──────────────────────────────────────────── -->
<div class="section-title">🏆 Classement (top 50)</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>#</th><th>Membre</th><th>Niveau</th><th>XP total</th><th>Messages</th></tr></thead>
    <tbody>
      <% if (leaderboard.length === 0) { %><tr><td colspan="5" class="empty-row">Aucune donnée XP encore.</td></tr><% } %>
      <% leaderboard.forEach((u, i) => { %>
        <tr>
          <td class="rank-pos">#<%= i + 1 %></td>
          <td class="user-cell"><%= u.username || u.userId %></td>
          <td><span class="badge badge-gold">Niv. <%= u.level %></span></td>
          <td><%= u.totalXp.toLocaleString('fr-FR') %></td>
          <td><%= u.messageCount.toLocaleString('fr-FR') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
