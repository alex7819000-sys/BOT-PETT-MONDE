<%- include('../partials/header', {pageTitle: 'Classement Staff', pageDesc: 'Performance hebdomadaire et all-time de l\'équipe'}) %>

<div class="form-row">
  <div>
    <div class="section-title">📅 Cette semaine</div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>#</th><th>Staff</th><th>Score</th><th>Grade</th></tr></thead>
        <tbody>
          <% if (weekly.length === 0) { %><tr><td colspan="4" class="empty-row">Aucune donnée cette semaine.</td></tr><% } %>
          <% weekly.forEach((s, i) => { %>
            <tr>
              <td class="rank-pos"><%= i === 0 ? '👑' : '#' + (i+1) %></td>
              <td class="user-cell"><%= s.userId %></td>
              <td><span class="badge badge-gold"><%= s.weekScore %> pts</span></td>
              <td><%= s.grade %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div>
    <div class="section-title">🏆 All-time</div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>#</th><th>Staff</th><th>Score total</th><th>Couronnes</th></tr></thead>
        <tbody>
          <% if (allTime.length === 0) { %><tr><td colspan="4" class="empty-row">Aucune donnée.</td></tr><% } %>
          <% allTime.forEach((s, i) => { %>
            <tr>
              <td class="rank-pos"><%= i === 0 ? '👑' : '#' + (i+1) %></td>
              <td class="user-cell"><%= s.userId %></td>
              <td><span class="badge badge-sage"><%= s.totalScore %> pts</span></td>
              <td><%= s.kingStaffCount %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
