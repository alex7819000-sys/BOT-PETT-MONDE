<%- include('../partials/header', {pageTitle: 'Messages & Embeds', pageDesc: 'Crée de beaux messages pour tes salons, avec boutons qui font de vraies actions', saved: saved, flashOk: flashOk, flashError: flashError}) %>

<style>
.embed-editor { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:24px; align-items:start; }
@media(max-width:1000px) { .embed-editor { grid-template-columns:1fr; } }
.embed-live { position:sticky; top:20px; }
@media(max-width:1000px) { .embed-live { position:static; } }

/* ── Aperçu façon Discord ─────────────────────────────── */
.dc-msg { background:#313338; border-radius:10px; padding:16px; color:#dbdee1; font-family:'gg sans','Noto Sans','Helvetica Neue',Arial,sans-serif; }
.dc-head { display:flex; align-items:center; gap:10px; margin-bottom:8px; }
.dc-avatar { width:38px; height:38px; border-radius:50%; background:#e2c97e; object-fit:cover; display:flex; align-items:center; justify-content:center; font-size:16px; color:#211705; flex-shrink:0; }
.dc-name { font-size:14px; font-weight:600; color:#fff; }
.dc-tag { background:#5865f2; color:#fff; font-size:10px; font-weight:600; border-radius:4px; padding:1px 5px; margin-left:6px; vertical-align:1px; }
.dc-time { font-size:11px; color:#949ba4; margin-left:8px; font-weight:400; }
.dc-content { font-size:14px; line-height:1.5; white-space:pre-wrap; word-break:break-word; margin-bottom:6px; }
.embed-preview { background:#2b2d31; border-radius:6px; padding:12px 16px 14px; border-left:4px solid #e2c97e; max-width:520px; position:relative; overflow:hidden; }
.embed-preview::after { content:''; display:block; clear:both; }
.ep-author { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
.ep-author img { width:24px; height:24px; border-radius:50%; object-fit:cover; }
.ep-author span { font-size:13px; font-weight:600; color:#fff; }
.ep-title { font-weight:700; color:#fff; font-size:16px; margin-bottom:8px; word-break:break-word; }
.ep-title a { color:#00a8fc; text-decoration:none; }
.ep-title a:hover { text-decoration:underline; }
.ep-desc, .ep-field-value { color:#dbdee1; font-size:14px; line-height:1.5; white-space:pre-wrap; word-break:break-word; }
.ep-fields { display:grid; grid-template-columns:repeat(12,1fr); gap:8px 10px; margin-top:8px; }
.ep-field { grid-column:span 12; min-width:0; }
.ep-field.inline { grid-column:span 4; }
.ep-field-name { font-size:14px; font-weight:700; color:#fff; margin-bottom:2px; word-break:break-word; }
.ep-image { max-width:100%; border-radius:4px; margin-top:12px; display:none; }
.ep-thumbnail { float:right; width:80px; height:80px; border-radius:4px; object-fit:cover; display:none; margin:0 0 8px 14px; }
.ep-footer { color:#949ba4; font-size:12px; margin-top:10px; display:none; align-items:center; gap:8px; }
.ep-footer img { width:20px; height:20px; border-radius:50%; object-fit:cover; }
.dc-buttons { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }
.btn-discord { padding:0 16px; height:32px; display:inline-flex; align-items:center; gap:6px; border-radius:4px; font-size:14px; font-weight:500; color:#fff; cursor:default; }
.btn-discord.primary { background:#5865f2; } .btn-discord.secondary { background:#4e5058; }
.btn-discord.success { background:#248046; } .btn-discord.danger { background:#da373c; }
.btn-discord.link { background:#4e5058; }
/* markdown */
.md-code { background:#1e1f22; border-radius:3px; padding:1px 4px; font-family:Consolas,monospace; font-size:13px; }
.md-pre { background:#1e1f22; border:1px solid #1a1b1e; border-radius:4px; padding:8px; font-family:Consolas,monospace; font-size:13px; display:block; margin:4px 0; white-space:pre-wrap; }
.md-link { color:#00a8fc; text-decoration:none; } .md-link:hover { text-decoration:underline; }
.md-mention { background:rgba(88,101,242,.3); color:#c9cdfb; border-radius:3px; padding:0 2px; font-weight:500; }
.md-spoiler { background:#1e1f22; color:transparent; border-radius:3px; padding:0 2px; }
.md-spoiler:hover { color:#dbdee1; }
.md-h { font-weight:700; color:#fff; } .md-h1 { font-size:22px; margin:6px 0 2px; } .md-h2 { font-size:18px; margin:6px 0 2px; } .md-h3 { font-size:16px; margin:4px 0 2px; }
.md-small { font-size:12px; color:#949ba4; }
.md-quote { border-left:4px solid #4e5058; padding-left:10px; margin:2px 0; }
.md-li { padding-left:6px; }
.md-emoji { width:22px; height:22px; vertical-align:-5px; }

/* ── Éditeur ──────────────────────────────────────────── */
.ed-banner { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; background:var(--elevated); border:1px solid var(--border); border-radius:8px; padding:10px 14px; margin-bottom:16px; font-size:13px; }
.ed-banner b { color:var(--gold-bright); }
.counter { font-size:11px; color:var(--text-dim); text-align:right; margin-top:3px; }
.counter.over { color:#ff7b86; font-weight:700; }
.fmt-bar { display:flex; gap:4px; flex-wrap:wrap; margin-bottom:6px; }
.fmt-bar button { background:var(--elevated); border:1px solid var(--border); color:var(--text); border-radius:5px; min-width:30px; height:28px; font-size:12.5px; cursor:pointer; padding:0 8px; }
.fmt-bar button:hover { border-color:var(--gold-dim); }
.color-row { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
.color-row input[type=color] { width:42px; height:36px; padding:2px; background:var(--elevated); border:1px solid var(--border); border-radius:6px; cursor:pointer; }
.color-row input[type=text] { width:110px; }
.swatches { display:flex; gap:6px; flex-wrap:wrap; }
.swatch { width:22px; height:22px; border-radius:50%; border:2px solid transparent; cursor:pointer; padding:0; }
.swatch:hover { border-color:#fff; }
.item-row { background:var(--elevated); border:1px solid var(--border); border-radius:8px; padding:10px; margin-bottom:8px; display:grid; gap:8px; }
.item-row .line { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
.item-row .line > input, .item-row .line > select, .item-row .line > textarea { flex:1; min-width:110px; }
.item-row .mini { flex:0 0 auto !important; width:auto !important; min-width:0 !important; }
.item-row .line > input.emo { flex:0 0 64px !important; width:64px !important; min-width:0 !important; text-align:center; }
.btn-icon { width:30px; height:30px; border-radius:6px; background:var(--surface); border:1px solid var(--border); color:var(--text-muted); cursor:pointer; font-size:13px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.btn-icon:hover { border-color:var(--gold-dim); color:var(--text); }
.btn-icon.del:hover { background:#da373c; color:#fff; border-color:#da373c; }
.tpl-bar { display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:16px; }
.tpl-bar select { max-width:260px; }
.saved-list { display:flex; flex-direction:column; gap:8px; margin-top:16px; }
.saved-item { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; background:var(--elevated); border-radius:8px; padding:12px 16px; }
.saved-item-info { display:flex; flex-direction:column; gap:3px; min-width:0; }
.saved-item-name { font-size:13px; font-weight:600; color:var(--text); }
.saved-item-channel { font-size:11px; color:var(--text-muted); }
.saved-item-actions { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
.tabs { display:flex; gap:0; border-bottom:2px solid var(--border); margin-bottom:20px; }
.tab { padding:10px 18px; font-size:13px; font-weight:500; color:var(--text-muted); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-2px; transition:.15s; }
.tab.active { color:var(--gold-bright); border-bottom-color:var(--gold); }
.tab-content { display:none; } .tab-content.active { display:block; }
.hint-box { font-size:12px; color:var(--text-muted); line-height:1.6; background:var(--surface); border:1px dashed var(--border); border-radius:8px; padding:10px 12px; margin-top:8px; }
</style>

<!-- Onglets -->
<div class="tabs">
  <div class="tab active" data-tab="create" onclick="switchTab('create')">✏️ Créer / modifier</div>
  <div class="tab" data-tab="saved" onclick="switchTab('saved')">📋 Mes embeds (<%= (savedEmbeds||[]).length %>)</div>
</div>

<!-- ══════════ TAB CRÉER ══════════ -->
<div class="tab-content active" id="tab-create">

  <div class="tpl-bar">
    <select id="tplSelect">
      <option value="">✨ Partir d'un modèle…</option>
      <option value="ticket">🎫 Panneau tickets (4 boutons)</option>
      <option value="sanctions">⚠️ Avertissements & sanctions</option>
      <option value="reglement">📜 Règlement</option>
      <option value="annonce">📢 Annonce</option>
      <option value="bienvenue">👋 Bienvenue / infos</option>
    </select>
    <button type="button" class="btn btn-sm" onclick="applyTemplate()">Utiliser</button>
    <button type="button" class="btn btn-sm btn-ghost" onclick="newEmbed()">🆕 Page blanche</button>
  </div>

  <div class="ed-banner" id="ed-banner" style="display:none">
    <span id="ed-banner-text"></span>
  </div>

  <div class="embed-editor">

    <!-- ── Éditeur ── -->
    <div>
      <form method="POST" action="/dashboard/<%= guild.id %>/embeds" id="embed-form" autocomplete="off">
        <input type="hidden" name="section" value="create">
        <input type="hidden" name="embedId" id="embedId" value="">
        <input type="hidden" id="fieldsData" name="fieldsData" value="[]">
        <input type="hidden" id="buttonsData" name="buttonsData" value="[]">

        <div class="form-row">
          <div class="form-group">
            <label class="field-label">Nom de sauvegarde <span style="color:var(--text-dim)">(pour toi, pas affiché)</span></label>
            <input type="text" id="embedName" name="embedName" maxlength="80" placeholder="Ex : Règlement" value="">
          </div>
          <div class="form-group">
            <label class="field-label">Salon de destination</label>
            <select name="embedChannelId" id="embedChannel" data-channel-search data-current="">
              <option value="">— Choisir un salon —</option>
              <% textChannels.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
            </select>
          </div>
        </div>

        <div class="config-group-title" style="margin:18px 0 10px;">💬 Texte au-dessus (optionnel)</div>
        <div class="form-group">
          <textarea id="embedContent" name="embedContent" rows="2" data-max="<%= limits.content %>" placeholder="Ex : @everyone — ou une phrase d'intro. Les pings fonctionnent ici."></textarea>
        </div>

        <div class="config-group-title" style="margin:18px 0 10px;">🎨 Apparence</div>

        <div class="form-group">
          <label class="field-label">Couleur de la barre</label>
          <div class="color-row">
            <input type="color" id="embedColorPicker" value="#e2c97e">
            <input type="text" id="embedColor" name="embedColor" value="#e2c97e" maxlength="7" placeholder="#e2c97e">
            <div class="swatches" id="swatches"></div>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="field-label">Auteur (petit texte tout en haut)</label>
            <input type="text" id="embedAuthor" name="embedAuthor" data-max="<%= limits.author %>" placeholder="Ex : HERA 🍉">
          </div>
          <div class="form-group">
            <label class="field-label">Icône de l'auteur (lien image)</label>
            <input type="url" id="embedAuthorIcon" name="embedAuthorIcon" placeholder="https://...">
          </div>
        </div>
        <div class="form-group">
          <label class="field-label">Lien de l'auteur <span style="color:var(--text-dim)">(optionnel)</span></label>
          <input type="url" id="embedAuthorUrl" name="embedAuthorUrl" placeholder="https://...">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="field-label">Titre</label>
            <input type="text" id="embedTitle" name="embedTitle" data-max="<%= limits.title %>" placeholder="Titre de l'embed">
          </div>
          <div class="form-group">
            <label class="field-label">Lien du titre <span style="color:var(--text-dim)">(optionnel)</span></label>
            <input type="url" id="embedTitleUrl" name="embedTitleUrl" placeholder="https://...">
          </div>
        </div>

        <div class="form-group">
          <label class="field-label">Description</label>
          <div class="fmt-bar" data-for="embedDesc">
            <button type="button" data-b="**" data-a="**" title="Gras"><b>G</b></button>
            <button type="button" data-b="*" data-a="*" title="Italique"><i>I</i></button>
            <button type="button" data-b="__" data-a="__" title="Souligné"><u>S</u></button>
            <button type="button" data-b="~~" data-a="~~" title="Barré"><s>B</s></button>
            <button type="button" data-b="`" data-a="`" title="Code">&lt;/&gt;</button>
            <button type="button" data-b="||" data-a="||" title="Spoiler (texte caché)">👁</button>
            <button type="button" data-p="# " title="Grand titre">T1</button>
            <button type="button" data-p="## " title="Titre moyen">T2</button>
            <button type="button" data-p="&gt; " title="Citation">❝</button>
            <button type="button" data-p="- " title="Liste">•</button>
            <button type="button" data-link="1" title="Lien">🔗</button>
          </div>
          <textarea id="embedDesc" name="embedDesc" rows="8" data-max="<%= limits.description %>" placeholder="Le texte principal. Tu peux utiliser les boutons ci-dessus ou écrire **gras**, *italique*, etc."></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="field-label">Grande image (lien)</label>
            <input type="url" id="embedImage" name="embedImage" placeholder="https://...">
          </div>
          <div class="form-group">
            <label class="field-label">Petite image à droite (lien)</label>
            <input type="url" id="embedThumb" name="embedThumb" placeholder="https://...">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="field-label">Footer (texte en bas)</label>
            <input type="text" id="embedFooter" name="embedFooter" data-max="<%= limits.footer %>" placeholder="Ex : Cordialement, la direction d'Hera 🍉">
          </div>
          <div class="form-group">
            <label class="field-label">Icône du footer (lien image)</label>
            <input type="url" id="embedFooterIcon" name="embedFooterIcon" placeholder="https://...">
          </div>
        </div>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin-bottom:6px;">
          <input type="checkbox" id="embedTimestamp" name="embedTimestamp"> Afficher la date et l'heure d'envoi en bas
        </label>

        <!-- CHAMPS -->
        <div class="config-group-title" style="margin:20px 0 10px;">📋 Champs <span style="font-weight:400;color:var(--text-dim)">(blocs titre + texte, max <%= limits.fields %>)</span></div>
        <div id="fields-container"></div>
        <button type="button" class="btn btn-sm" id="addFieldBtn" onclick="addField()">+ Ajouter un champ</button>

        <!-- BOUTONS -->
        <div class="config-group-title" style="margin:22px 0 10px;">🔘 Boutons <span style="font-weight:400;color:var(--text-dim)">(sous le message)</span></div>
        <div class="hint-box" style="margin:0 0 10px;">
          <b>🔗 Lien</b> ouvre une adresse web. Les autres boutons déclenchent une <b>vraie action du bot</b> (ticket, signalement, candidature, partenariat). Chaque action ne peut être utilisée qu'une fois par message.
        </div>
        <div id="buttons-container"></div>
        <button type="button" class="btn btn-sm" id="addButtonBtn" onclick="addButton()">+ Ajouter un bouton</button>

        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:26px;padding-top:18px;border-top:1px solid var(--border);">
          <button type="submit" name="action" value="send" class="btn btn-gold">📨 Envoyer dans le salon</button>
          <button type="submit" name="action" value="edit" class="btn btn-gold" id="btn-edit" style="display:none">✏️ Mettre à jour le message déjà posté</button>
          <button type="submit" name="action" value="save" class="btn">💾 Sauvegarder sans envoyer</button>
        </div>
      </form>
    </div>

    <!-- ── Aperçu ── -->
    <div class="embed-live">
      <div class="field-label" style="margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;">
        <span>👁️ Aperçu (comme sur Discord)</span>
        <span class="counter" id="total-counter" style="margin:0"></span>
      </div>
      <div class="dc-msg">
        <div class="dc-head">
          <% if (botAvatar) { %><img class="dc-avatar" src="<%= botAvatar %>" alt=""><% } else { %><div class="dc-avatar">♛</div><% } %>
          <div>
            <span class="dc-name"><%= botName %></span><span class="dc-tag">BOT</span><span class="dc-time" id="dc-time"></span>
          </div>
        </div>
        <div class="dc-content" id="prev-content" style="display:none"></div>
        <div class="embed-preview" id="live-preview">
          <img class="ep-thumbnail" id="prev-thumb" alt="">
          <div class="ep-author" id="prev-author" style="display:none"><img id="prev-author-icon" alt="" style="display:none"><span id="prev-author-name"></span></div>
          <div class="ep-title" id="prev-title" style="display:none"></div>
          <div class="ep-desc" id="prev-desc"></div>
          <div class="ep-fields" id="prev-fields"></div>
          <img class="ep-image" id="prev-image" alt="">
          <div class="ep-footer" id="prev-footer"><img id="prev-footer-icon" alt="" style="display:none"><span id="prev-footer-text"></span></div>
        </div>
        <div class="dc-buttons" id="prev-buttons"></div>
      </div>
      <div class="hint-box">
        💡 Tu peux mentionner un rôle avec <code>&lt;@&amp;ID&gt;</code>, un salon avec <code>&lt;#ID&gt;</code>, et utiliser un emoji du serveur avec <code>&lt;:nom:ID&gt;</code> (clic droit sur l'emoji → copier l'ID, avec le mode développeur de Discord).
        L'aperçu est très proche de Discord, mais les mentions s'affichent de façon simplifiée.
      </div>
    </div>

  </div>
</div>

<!-- ══════════ TAB SAUVEGARDÉS ══════════ -->
<div class="tab-content" id="tab-saved">
  <% if (!savedEmbeds || savedEmbeds.length === 0) { %>
    <div style="text-align:center;padding:40px;color:var(--text-muted);">
      <div style="font-size:32px;margin-bottom:8px;">📭</div>
      <div>Aucun embed sauvegardé pour l'instant.</div>
      <div style="font-size:12px;margin-top:6px;">Crée ton premier embed dans l'onglet « Créer / modifier ».</div>
    </div>
  <% } else { %>
    <div class="saved-list">
      <% savedEmbeds.forEach((e, i) => {
           const ch = textChannels.find(c => c.id === e.channelId);
           const label = e.title || (e.description || '').replace(/\s+/g, ' ').slice(0, 70) || '(vide)';
      %>
        <div class="saved-item">
          <div class="saved-item-info">
            <div class="saved-item-name">📄 <%= e.name %> <% if (e.messageId) { %><span class="badge badge-sage" style="margin-left:6px">posté</span><% } %></div>
            <div class="saved-item-channel"><%= label %> • <%= ch ? '#' + ch.name : 'salon non choisi' %> • <%= new Date(e.createdAt).toLocaleDateString('fr-FR') %></div>
          </div>
          <div class="saved-item-actions">
            <button type="button" class="btn btn-sm" onclick="loadSaved(<%= i %>, false)">✏️ Modifier</button>
            <button type="button" class="btn btn-sm btn-ghost" onclick="loadSaved(<%= i %>, true)">📋 Dupliquer</button>
            <form method="POST" action="/dashboard/<%= guild.id %>/embeds" style="display:inline-flex;gap:6px;align-items:center;">
              <input type="hidden" name="section" value="resend">
              <input type="hidden" name="embedId" value="<%= e._id %>">
              <select name="targetChannel" style="font-size:12px;padding:4px 8px;height:30px;" data-channel-search data-current="<%= e.channelId || '' %>">
                <% textChannels.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
              </select>
              <button type="submit" class="btn btn-sm btn-gold">📨 Renvoyer</button>
            </form>
            <form method="POST" action="/dashboard/<%= guild.id %>/embeds" style="display:inline;" onsubmit="return confirm('Supprimer cet embed de la liste ? (le message déjà posté sur Discord ne sera pas supprimé)')">
              <input type="hidden" name="section" value="delete">
              <input type="hidden" name="embedId" value="<%= e._id %>">
              <button type="submit" class="btn btn-sm" style="background:#da373c;color:#fff;">🗑️</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script type="application/json" id="saved-data"><%- JSON.stringify(savedEmbeds || []).replace(/</g, '\\u003c') %></script>
<script src="/js/embedPreview.js"></script>
<script>
(function () {
'use strict';
const { renderMarkdown, esc, safeUrl } = window.EmbedPreview;
const $ = (id) => document.getElementById(id);
const LIMITS = <%- JSON.stringify(limits) %>;
const SAVED = JSON.parse($('saved-data').textContent || '[]');
// Le sélecteur de salon est remplacé au chargement par un widget de recherche (voir app.js)
function setChannel(id) { const h = $('embedChannel'); if (h && h.setChannel) h.setChannel(id || ''); else if (h) h.value = id || ''; }
function getChannel() { const h = $('embedChannel'); return h ? h.value : ''; }

// ─── Onglets ────────────────────────────────────────────────────
window.switchTab = function (name) {
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.tab === name));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.toggle('active', t.id === 'tab-' + name));
};

// ─── État ───────────────────────────────────────────────────────
let fields = [];
let buttons = [];
let editing = { id: '', messageId: '', name: '' };

const BTN_STYLES  = { primary: 'Bleu', secondary: 'Gris', success: 'Vert', danger: 'Rouge' };
const BTN_ACTIONS = {
  link:    '🔗 Lien (ouvre une adresse)',
  ticket:  '🎫 Ouvrir un ticket',
  report:  '🚨 Faire un signalement',
  staff:   '🙋 Candidater au staff',
  partner: '🤝 Demande de partenariat',
};
const SWATCHES = ['#e2c97e', '#5865F2', '#57F287', '#FEE75C', '#EB459E', '#ED4245', '#FFAA00', '#FFFFFF'];

// ─── Couleur ────────────────────────────────────────────────────
const sw = $('swatches');
SWATCHES.forEach(c => {
  const b = document.createElement('button');
  b.type = 'button'; b.className = 'swatch'; b.style.background = c; b.title = c;
  b.onclick = () => { setColor(c); };
  sw.appendChild(b);
});
function setColor(c) {
  $('embedColor').value = c;
  if (/^#[0-9a-f]{6}$/i.test(c)) $('embedColorPicker').value = c.toLowerCase();
  updatePreview();
}
$('embedColorPicker').addEventListener('input', (e) => setColor(e.target.value));
$('embedColor').addEventListener('input', (e) => {
  const v = e.target.value.trim();
  if (/^#[0-9a-f]{6}$/i.test(v)) $('embedColorPicker').value = v.toLowerCase();
  updatePreview();
});

// ─── Compteurs de caractères ────────────────────────────────────
document.querySelectorAll('[data-max]').forEach(el => {
  const c = document.createElement('div');
  c.className = 'counter'; c.id = 'cnt-' + el.id;
  el.insertAdjacentElement('afterend', c);
});
function updateCounters() {
  document.querySelectorAll('[data-max]').forEach(el => {
    const max = Number(el.dataset.max), n = el.value.length, c = $('cnt-' + el.id);
    if (!c) return;
    c.textContent = n + ' / ' + max;
    c.classList.toggle('over', n > max);
  });
  const f = fields.filter(Boolean);
  const total = $('embedTitle').value.length + $('embedDesc').value.length + $('embedAuthor').value.length + $('embedFooter').value.length +
    f.reduce((n, x) => n + (x.name || '').length + (x.value || '').length, 0);
  const t = $('total-counter');
  t.textContent = 'Total embed : ' + total + ' / ' + LIMITS.total;
  t.classList.toggle('over', total > LIMITS.total);
}
function anyOverLimit() {
  return !!document.querySelector('.counter.over') ||
    fields.some(x => (x.name || '').length > LIMITS.fieldName || (x.value || '').length > LIMITS.fieldValue);
}

// ─── Barre de mise en forme (Description) ───────────────────────
document.querySelectorAll('.fmt-bar').forEach(bar => {
  const ta = $(bar.dataset.for);
  bar.querySelectorAll('button').forEach(btn => btn.addEventListener('click', () => {
    const s = ta.selectionStart, e = ta.selectionEnd, sel = ta.value.slice(s, e);
    let ins, selStart, selEnd;
    if (btn.dataset.link) {
      const txt = sel || 'texte';
      ins = '[' + txt + '](https://)';
      selStart = s + txt.length + 3; selEnd = selStart + 8;
    } else if (btn.dataset.p) {
      // préfixe de ligne (titre, citation, liste)
      const lineStart = ta.value.lastIndexOf('\n', s - 1) + 1;
      ta.value = ta.value.slice(0, lineStart) + btn.dataset.p + ta.value.slice(lineStart);
      ta.focus(); ta.setSelectionRange(s + btn.dataset.p.length, e + btn.dataset.p.length);
      updatePreview(); return;
    } else {
      const before = btn.dataset.b, after = btn.dataset.a, mid = sel || 'texte';
      ins = before + mid + after;
      selStart = s + before.length; selEnd = selStart + mid.length;
    }
    ta.value = ta.value.slice(0, s) + ins + ta.value.slice(e);
    ta.focus(); ta.setSelectionRange(selStart, selEnd);
    updatePreview();
  }));
});

// ─── Champs ─────────────────────────────────────────────────────
window.addField = function (name, value, inline) {
  if (fields.length >= LIMITS.fields) return;
  fields.push({ name: name || '', value: value || '', inline: !!inline });
  renderFieldsEditor(); updatePreview();
};
function moveItem(arr, i, d) {
  const j = i + d; if (j < 0 || j >= arr.length) return;
  const t = arr[i]; arr[i] = arr[j]; arr[j] = t;
}
function iconBtn(txt, title, cls, fn) {
  const b = document.createElement('button');
  b.type = 'button'; b.className = 'btn-icon ' + (cls || ''); b.textContent = txt; b.title = title; b.onclick = fn;
  return b;
}
function renderFieldsEditor() {
  const c = $('fields-container'); c.innerHTML = '';
  fields.forEach((f, i) => {
    const row = document.createElement('div'); row.className = 'item-row';
    const l1 = document.createElement('div'); l1.className = 'line';
    const name = document.createElement('input'); name.type = 'text'; name.placeholder = 'Titre du champ'; name.value = f.name;
    name.oninput = () => { f.name = name.value; updatePreview(); };
    const lab = document.createElement('label'); lab.className = 'mini'; lab.style.cssText = 'font-size:12px;color:var(--text-muted);display:flex;align-items:center;gap:4px;white-space:nowrap';
    const cb = document.createElement('input'); cb.type = 'checkbox'; cb.checked = f.inline;
    cb.onchange = () => { f.inline = cb.checked; updatePreview(); };
    lab.append(cb, ' Côte à côte');
    l1.append(name, lab,
      iconBtn('↑', 'Monter', '', () => { moveItem(fields, i, -1); renderFieldsEditor(); updatePreview(); }),
      iconBtn('↓', 'Descendre', '', () => { moveItem(fields, i, 1); renderFieldsEditor(); updatePreview(); }),
      iconBtn('✕', 'Supprimer', 'del', () => { fields.splice(i, 1); renderFieldsEditor(); updatePreview(); }));
    const l2 = document.createElement('div'); l2.className = 'line';
    const val = document.createElement('textarea'); val.rows = 2; val.placeholder = 'Texte du champ (le markdown fonctionne aussi)'; val.value = f.value;
    val.oninput = () => { f.value = val.value; updatePreview(); };
    l2.append(val);
    row.append(l1, l2); c.appendChild(row);
  });
  $('addFieldBtn').disabled = fields.length >= LIMITS.fields;
}

// ─── Boutons ────────────────────────────────────────────────────
window.addButton = function (b) {
  if (buttons.length >= LIMITS.buttons) return;
  buttons.push(Object.assign({ label: '', emoji: '', style: 'primary', url: '', action: 'link' }, b || {}));
  renderButtonsEditor(); updatePreview();
};
function renderButtonsEditor() {
  const c = $('buttons-container'); c.innerHTML = '';
  buttons.forEach((b, i) => {
    const row = document.createElement('div'); row.className = 'item-row';
    const l1 = document.createElement('div'); l1.className = 'line';
    const emoji = document.createElement('input'); emoji.type = 'text'; emoji.placeholder = '😀'; emoji.value = b.emoji; emoji.maxLength = 60; emoji.className = 'emo'; emoji.title = 'Emoji (optionnel)';
    emoji.oninput = () => { b.emoji = emoji.value; updatePreview(); };
    const label = document.createElement('input'); label.type = 'text'; label.placeholder = 'Texte du bouton'; label.value = b.label; label.maxLength = LIMITS.buttonLabel;
    label.oninput = () => { b.label = label.value; updatePreview(); };
    l1.append(emoji, label,
      iconBtn('↑', 'Monter', '', () => { moveItem(buttons, i, -1); renderButtonsEditor(); updatePreview(); }),
      iconBtn('↓', 'Descendre', '', () => { moveItem(buttons, i, 1); renderButtonsEditor(); updatePreview(); }),
      iconBtn('✕', 'Supprimer', 'del', () => { buttons.splice(i, 1); renderButtonsEditor(); updatePreview(); }));
    const l2 = document.createElement('div'); l2.className = 'line';
    const act = document.createElement('select');
    Object.entries(BTN_ACTIONS).forEach(([k, v]) => { const o = document.createElement('option'); o.value = k; o.textContent = v; if (b.action === k) o.selected = true; act.appendChild(o); });
    const style = document.createElement('select'); style.title = 'Couleur du bouton';
    Object.entries(BTN_STYLES).forEach(([k, v]) => { const o = document.createElement('option'); o.value = k; o.textContent = v; if (b.style === k) o.selected = true; style.appendChild(o); });
    const url = document.createElement('input'); url.type = 'url'; url.placeholder = 'https://...'; url.value = b.url;
    const sync = () => { const isLink = b.action === 'link'; style.style.display = isLink ? 'none' : ''; url.style.display = isLink ? '' : 'none'; };
    act.onchange = () => { b.action = act.value; sync(); updatePreview(); };
    style.onchange = () => { b.style = style.value; updatePreview(); };
    url.oninput = () => { b.url = url.value; };
    sync();
    l2.append(act, style, url);
    row.append(l1, l2); c.appendChild(row);
  });
  $('addButtonBtn').disabled = buttons.length >= LIMITS.buttons;
}

// ─── Aperçu ─────────────────────────────────────────────────────
function updatePreview() {
  const val = (id) => $(id).value;
  const color = val('embedColor');
  $('live-preview').style.borderLeftColor = /^#?[0-9a-f]{6}$/i.test(color.trim()) ? (color.trim().startsWith('#') ? color.trim() : '#' + color.trim()) : '#4e5058';

  const content = val('embedContent');
  const pc = $('prev-content'); pc.style.display = content.trim() ? 'block' : 'none'; pc.innerHTML = renderMarkdown(content, { inline: true });

  const author = val('embedAuthor').trim();
  $('prev-author').style.display = author ? 'flex' : 'none';
  $('prev-author-name').textContent = author;
  const ai = $('prev-author-icon'), aiu = safeUrl(val('embedAuthorIcon').trim());
  ai.style.display = aiu ? 'block' : 'none'; if (aiu) ai.src = aiu;

  const title = val('embedTitle').trim(), tu = safeUrl(val('embedTitleUrl').trim());
  const te = $('prev-title'); te.style.display = title ? 'block' : 'none';
  te.innerHTML = tu ? '<a href="' + esc(tu) + '" target="_blank" rel="noopener noreferrer">' + esc(title) + '</a>' : esc(title);

  $('prev-desc').innerHTML = renderMarkdown(val('embedDesc'));
  $('prev-desc').style.display = val('embedDesc').trim() ? 'block' : 'none';

  const im = $('prev-image'), imu = safeUrl(val('embedImage').trim()); im.style.display = imu ? 'block' : 'none'; if (imu) im.src = imu;
  const th = $('prev-thumb'), thu = safeUrl(val('embedThumb').trim()); th.style.display = thu ? 'block' : 'none'; if (thu) th.src = thu;

  const footer = val('embedFooter').trim(), ts = $('embedTimestamp').checked;
  const fe = $('prev-footer'); fe.style.display = (footer || ts) ? 'flex' : 'none';
  const nowTxt = new Date().toLocaleString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  $('prev-footer-text').textContent = footer + (footer && ts ? ' • ' : '') + (ts ? nowTxt : '');
  const fi = $('prev-footer-icon'), fiu = safeUrl(val('embedFooterIcon').trim()); fi.style.display = (fiu && footer) ? 'block' : 'none'; if (fiu) fi.src = fiu;

  const pf = $('prev-fields');
  pf.innerHTML = fields.map(f => '<div class="ep-field' + (f.inline ? ' inline' : '') + '"><div class="ep-field-name">' + esc(f.name || 'Champ') + '</div><div class="ep-field-value">' + renderMarkdown(f.value || '', { inline: false }) + '</div></div>').join('');

  $('prev-buttons').innerHTML = buttons.map(b => {
    const cls = b.action === 'link' ? 'link' : (BTN_STYLES[b.style] ? b.style : 'primary');
    const emo = b.emoji ? renderMarkdown(b.emoji, { inline: true }) + ' ' : '';
    return '<div class="btn-discord ' + cls + '">' + emo + esc(b.label || (b.emoji ? '' : 'Bouton')) + (b.action === 'link' ? ' ↗' : '') + '</div>';
  }).join('');

  // l'aperçu seul n'a pas d'embed si tout est vide
  const empty = !title && !author && !val('embedDesc').trim() && !footer && !ts && !fields.length && !imu && !thu;
  $('live-preview').style.display = empty ? 'none' : 'block';
  updateCounters();
}
document.querySelectorAll('#embed-form input[type=text], #embed-form input[type=url], #embed-form textarea, #embed-form input[type=checkbox]').forEach(el => {
  if (el.id) el.addEventListener('input', updatePreview);
});
$('embedTimestamp').addEventListener('change', updatePreview);
$('dc-time').textContent = 'Aujourd’hui à ' + new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });

// ─── Bannière "tu modifies…" ────────────────────────────────────
function refreshBanner() {
  const b = $('ed-banner');
  if (editing.id) {
    b.style.display = 'flex';
    $('ed-banner-text').innerHTML = '✏️ Tu modifies : <b>' + esc(editing.name || 'Sans nom') + '</b>' +
      (editing.messageId ? ' — déjà posté sur Discord : tu peux <b>mettre à jour le message</b> au lieu d’en poster un nouveau.' : ' — pas encore posté.');
  } else b.style.display = 'none';
  $('btn-edit').style.display = (editing.id && editing.messageId) ? '' : 'none';
}

// ─── Remplir l'éditeur ──────────────────────────────────────────
function fill(e) {
  $('embedName').value = e.name || '';
  setChannel(e.channelId);
  $('embedContent').value = e.content || '';
  $('embedAuthor').value = e.author || '';
  $('embedAuthorIcon').value = e.authorIcon || '';
  $('embedAuthorUrl').value = e.authorUrl || '';
  $('embedTitle').value = e.title || '';
  $('embedTitleUrl').value = e.titleUrl || '';
  $('embedDesc').value = e.description || '';
  $('embedImage').value = e.image || '';
  $('embedThumb').value = e.thumbnail || '';
  $('embedFooter').value = e.footer || '';
  $('embedFooterIcon').value = e.footerIcon || '';
  $('embedTimestamp').checked = !!e.timestamp;
  setColor(e.color || '#e2c97e');
  fields = (e.fields || []).map(f => ({ name: f.name || '', value: f.value || '', inline: !!f.inline }));
  // Anciens embeds (avant la v100) sans action : on les traite comme des liens
  buttons = (e.buttons || []).map(b => ({ label: b.label || '', emoji: b.emoji || '', style: b.style || 'primary', url: b.url || '', action: b.action || 'link' }));
  renderFieldsEditor(); renderButtonsEditor(); updatePreview();
}
window.loadSaved = function (i, duplicate) {
  const e = SAVED[i]; if (!e) return;
  switchTab('create');
  fill(duplicate ? Object.assign({}, e, { name: (e.name || 'Sans nom') + ' (copie)' }) : e);
  editing = duplicate ? { id: '', messageId: '', name: '' } : { id: e._id, messageId: e.messageId || '', name: e.name };
  $('embedId').value = editing.id;
  refreshBanner();
  window.scrollTo({ top: 0, behavior: 'smooth' });
};
window.newEmbed = function () {
  fill({ color: '#e2c97e' });
  editing = { id: '', messageId: '', name: '' }; $('embedId').value = ''; refreshBanner();
};

// ─── Modèles prêts à l'emploi ───────────────────────────────────
const TEMPLATES = {
  ticket: {
    name: 'Panneau tickets', color: '#e2c97e', author: 'HERA 🍉', title: 'Support & Recrutement',
    description: 'Besoin de nous contacter ? Choisis le bouton qui correspond à ta demande :\n\n🎫 **Ticket** — une question, une demande, un souci\n🤝 **Partenariat** — proposer un partenariat\n📝 **Candidatures / recrutement** — rejoindre l’équipe\n🚨 **Réclamations / signalements** — signaler un membre ou un problème',
    footer: 'Un ticket = un salon privé avec le staff.',
    buttons: [
      { emoji: '🎫', label: 'Ticket', style: 'success', action: 'ticket' },
      { emoji: '🤝', label: 'Partenariat', style: 'success', action: 'partner' },
      { emoji: '📝', label: 'Candidatures / recrutement', style: 'primary', action: 'staff' },
      { emoji: '🚨', label: 'Réclamations / signalements', style: 'danger', action: 'report' },
    ],
  },
  sanctions: {
    name: 'Avertissements & sanctions', color: '#FFAA00', title: '⚠️ Avertissements & Sanctions',
    description: 'Ici, les sanctions ne tombent pas au hasard : chaque signalement est **vérifié par le staff** avant toute décision.',
    fields: [
      { name: '📈 Les paliers', value: '1. **Avertissement**\n2. **Mute** (temporaire)\n3. **Ban vocal** (temporaire)\n4. **Ban tchat** (temporaire)\n5. **Kick**\n6. **Ban définitif**', inline: false },
      { name: '⏱️ Durées possibles', value: '10 min • 1 h • 6 h • 24 h • 48 h • 7 jours', inline: false },
      { name: '🚨 Comment signaler ?', value: 'Clique sur le bouton ci-dessous, choisis le membre, explique ce qui s’est passé et ajoute une capture d’écran si tu en as une.', inline: false },
      { name: '🔎 Et ensuite ?', value: 'Un modérateur examine la demande. Il peut valider, choisir une autre sanction, refuser, ou te demander des précisions dans un fil privé.', inline: false },
    ],
    footer: 'Cordialement, la direction d’Hera 🍉',
    buttons: [{ emoji: '🚨', label: 'Faire un signalement', style: 'danger', action: 'report' }],
  },
  reglement: {
    name: 'Règlement', color: '#5865F2', title: '📜 Règlement du serveur',
    description: 'En restant sur le serveur, tu acceptes ces règles. Elles sont là pour que tout le monde passe un bon moment.',
    fields: [
      { name: '1. Respect', value: 'Pas d’insultes, de harcèlement, de discrimination ni de provocation.', inline: false },
      { name: '2. Pas de spam', value: 'Pas de flood, de pub non autorisée ni de messages répétés.', inline: false },
      { name: '3. Contenu approprié', value: 'Aucun contenu choquant, illégal ou NSFW en dehors des salons prévus.', inline: false },
