    description: 'Salut tout le monde ! 👋\n\nÉcris ici le contenu de ton annonce.\n\n> Astuce : utilise les boutons de mise en forme pour mettre des mots en **gras** ou créer des listes.',
    footer: 'L’équipe de HERA 🍉', timestamp: true,
  },
  bienvenue: {
    name: 'Bienvenue / infos', color: '#57F287', title: '👋 Bienvenue sur le serveur !',
    description: 'Content de te voir ici ! Voilà de quoi bien démarrer :',
    fields: [
      { name: '📜 Règlement', value: 'Lis-le avant de discuter.', inline: true },
      { name: '💬 Discuter', value: 'Présente-toi et lance la conversation !', inline: true },
      { name: '🎫 Besoin d’aide ?', value: 'Ouvre un ticket, le staff te répond.', inline: true },
    ],
    footer: 'On est contents de t’accueillir 🍉',
  },
};
window.applyTemplate = function () {
  const k = $('tplSelect').value; if (!k) return;
  const t = TEMPLATES[k]; if (!t) return;
  const dirty = $('embedTitle').value || $('embedDesc').value || fields.length || buttons.length;
  if (dirty && !confirm('Remplacer ce que tu as écrit par ce modèle ?')) return;
  fill(Object.assign({ channelId: getChannel() }, t));
  editing = { id: '', messageId: '', name: '' }; $('embedId').value = ''; refreshBanner();
};

// ─── Envoi du formulaire ────────────────────────────────────────
$('embed-form').addEventListener('submit', (ev) => {
  $('fieldsData').value  = JSON.stringify(fields);
  $('buttonsData').value = JSON.stringify(buttons);
  const act = ev.submitter && ev.submitter.value;
  if (act === 'send' || act === 'edit') {
    if (!getChannel()) { ev.preventDefault(); alert('Choisis d’abord le salon de destination.'); return; }
    if (anyOverLimit()) { ev.preventDefault(); alert('Un des compteurs est en rouge : Discord refuserait le message. Raccourcis le texte concerné.'); return; }
    if (act === 'send' && editing.messageId && !confirm('Ce message a déjà été posté. « Envoyer » va en poster un DEUXIÈME. Pour modifier l’existant, utilise « Mettre à jour le message déjà posté ». Continuer quand même ?')) { ev.preventDefault(); return; }
  }
});

// Départ : page blanche (ou rien d'autre à faire)
renderFieldsEditor(); renderButtonsEditor(); updatePreview();
})();
</script>

