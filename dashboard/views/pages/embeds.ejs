<%- include('../partials/header', {pageTitle: 'Messages & Embeds', pageDesc: 'Créez des messages interactifs avec boutons et sélecteurs', saved: saved}) %>

<style>
.embed-editor { display:grid; grid-template-columns:1fr 1fr; gap:24px; align-items:start; }
@media(max-width:900px) { .embed-editor { grid-template-columns:1fr; } }
.embed-live { position:sticky; top:20px; }
.embed-preview { background:#2b2d31; border-radius:10px; padding:16px 18px; border-left:4px solid #5865f2; }
.embed-preview .ep-author { display:flex; align-items:center; gap:8px; margin-bottom:10px; }
.embed-preview .ep-author-icon { width:22px; height:22px; border-radius:50%; background:#5865f2; }
.embed-preview .ep-author-name { font-size:12px; font-weight:600; color:#dbdee1; }
.embed-preview .ep-title { font-weight:700; color:#fff; font-size:15px; margin-bottom:6px; }
.embed-preview .ep-desc { color:#dbdee1; font-size:13.5px; white-space:pre-wrap; line-height:1.6; }
.embed-preview .ep-fields { display:grid; gap:8px; margin-top:10px; }
.embed-preview .ep-field { background:#23262a; border-radius:6px; padding:8px 10px; }
.embed-preview .ep-field-name { font-size:12px; font-weight:700; color:#fff; margin-bottom:2px; }
.embed-preview .ep-field-value { font-size:12.5px; color:#dbdee1; }
.embed-preview .ep-image { max-width:100%; border-radius:6px; margin-top:10px; display:none; }
.embed-preview .ep-thumbnail { float:right; width:70px; height:70px; border-radius:6px; object-fit:cover; display:none; margin-left:12px; }
.embed-preview .ep-footer { color:#949ba4; font-size:11px; margin-top:12px; padding-top:8px; border-top:1px solid #3a3d42; display:flex; align-items:center; gap:6px; }
.embed-preview .ep-footer img { width:16px; height:16px; border-radius:50%; }
.buttons-preview { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
.btn-discord { padding:6px 14px; border-radius:4px; font-size:13px; font-weight:500; border:none; cursor:default; }
.btn-discord.primary { background:#5865f2; color:#fff; }
.btn-discord.secondary { background:#4e5058; color:#fff; }
.btn-discord.success { background:#248046; color:#fff; }
.btn-discord.danger { background:#da373c; color:#fff; }
.btn-discord.link { background:transparent; color:#00a8fc; border:1px solid #4e5058; }
.field-row { display:flex; gap:10px; align-items:center; margin-bottom:8px; }
.field-row input, .field-row select { flex:1; }
.field-row .btn-icon { width:32px; height:32px; border-radius:6px; background:var(--elevated); border:none; color:var(--text-muted); cursor:pointer; font-size:15px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.field-row .btn-icon:hover { background:#da373c; color:#fff; }
.saved-list { display:flex; flex-direction:column; gap:8px; margin-top:16px; }
.saved-item { display:flex; align-items:center; justify-content:space-between; background:var(--elevated); border-radius:8px; padding:12px 16px; }
.saved-item-info { display:flex; flex-direction:column; gap:2px; }
.saved-item-name { font-size:13px; font-weight:600; color:var(--text); }
.saved-item-channel { font-size:11px; color:var(--text-muted); }
.saved-item-actions { display:flex; gap:8px; }
.tabs { display:flex; gap:0; border-bottom:2px solid var(--border); margin-bottom:20px; }
.tab { padding:10px 18px; font-size:13px; font-weight:500; color:var(--text-muted); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-2px; transition:.15s; }
.tab.active { color:var(--accent); border-bottom-color:var(--accent); }
.tab-content { display:none; }
.tab-content.active { display:block; }
</style>

<!-- Tabs -->
<div class="tabs">
  <div class="tab active" onclick="switchTab('create')">✏️ Créer un embed</div>
  <div class="tab" onclick="switchTab('saved')">📋 Embeds sauvegardés (<%= (savedEmbeds||[]).length %>)</div>
</div>

<!-- TAB CRÉER -->
<div class="tab-content active" id="tab-create">
<div class="embed-editor">

  <!-- Panneau de gauche : éditeur -->
  <div>
    <form method="POST" action="/dashboard/<%= guild.id %>/embeds" id="embed-form">
      <input type="hidden" name="section" value="create">
      <input type="hidden" name="embedId" id="embedId" value="">

      <div class="form-group">
        <label class="field-label">Nom de sauvegarde</label>
        <input type="text" id="embedName" name="embedName" placeholder="Mon embed" value="">
      </div>

      <div class="form-group">
        <label class="field-label">Salon de destination</label>
        <select name="embedChannelId" id="embedChannel" data-channel-search data-current="">
          <option value="">— Choisir un salon —</option>
          <% textChannels.forEach(c => { %>
            <option value="<%= c.id %>">#<%= c.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="config-group-title" style="margin-top:20px;margin-bottom:12px;">🎨 Apparence</div>

      <div class="form-row">
        <div class="form-group">
          <label class="field-label">Couleur (hex)</label>
          <input type="text" id="embedColor" name="embedColor" value="#e2c97e" placeholder="#e2c97e" oninput="updatePreview()">
        </div>
        <div class="form-group">
          <label class="field-label">Auteur</label>
          <input type="text" id="embedAuthor" name="embedAuthor" placeholder="Nom de l'auteur" oninput="updatePreview()">
        </div>
      </div>

      <div class="form-group">
        <label class="field-label">Titre</label>
        <input type="text" id="embedTitle" name="embedTitle" placeholder="Titre de l'embed" oninput="updatePreview()">
      </div>

      <div class="form-group">
        <label class="field-label">Description</label>
        <textarea id="embedDesc" name="embedDesc" rows="5" placeholder="Contenu de l'embed... Markdown supporté (**gras**, *italique*, etc.)" oninput="updatePreview()"></textarea>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="field-label">Image (URL)</label>
          <input type="url" id="embedImage" name="embedImage" placeholder="https://..." oninput="updatePreview()">
        </div>
        <div class="form-group">
          <label class="field-label">Miniature (URL)</label>
          <input type="url" id="embedThumb" name="embedThumb" placeholder="https://..." oninput="updatePreview()">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="field-label">Footer</label>
          <input type="text" id="embedFooter" name="embedFooter" placeholder="Texte en bas..." oninput="updatePreview()">
        </div>
        <div class="form-group">
          <label class="field-label">URL footer icon</label>
          <input type="url" id="embedFooterIcon" name="embedFooterIcon" placeholder="https://..." oninput="updatePreview()">
        </div>
      </div>

      <!-- CHAMPS -->
      <div class="config-group-title" style="margin-top:20px;margin-bottom:12px;">📋 Champs</div>
      <div id="fields-container"></div>
      <button type="button" class="btn btn-sm" style="background:var(--elevated);color:var(--text);margin-bottom:20px;" onclick="addField()">+ Ajouter un champ</button>
      <input type="hidden" id="fieldsData" name="fieldsData" value="[]">

      <!-- BOUTONS -->
      <div class="config-group-title" style="margin-bottom:12px;">🔘 Boutons</div>
      <p class="field-hint" style="margin-bottom:12px;">Ajoute des boutons sous le message (lien URL ou action du bot).</p>
      <div id="buttons-container"></div>
      <button type="button" class="btn btn-sm" style="background:var(--elevated);color:var(--text);margin-bottom:20px;" onclick="addButton()">+ Ajouter un bouton</button>
      <input type="hidden" id="buttonsData" name="buttonsData" value="[]">

      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:8px;">
        <button type="submit" name="action" value="send" class="btn btn-gold" onclick="packData()">📨 Envoyer</button>
        <button type="submit" name="action" value="save" class="btn" style="background:var(--elevated);color:var(--text);" onclick="packData()">💾 Sauvegarder sans envoyer</button>
      </div>
    </form>
  </div>

  <!-- Panneau de droite : prévisualisation live -->
  <div class="embed-live">
    <div class="field-label" style="margin-bottom:10px;">👁️ Aperçu en direct</div>
    <div style="background:#313338;border-radius:10px;padding:16px;">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
        <div style="width:32px;height:32px;border-radius:50%;background:#e2c97e;display:flex;align-items:center;justify-content:center;font-size:14px;">♛</div>
        <div>
          <div style="font-size:13px;font-weight:600;color:#fff;">King Bot</div>
          <div style="font-size:11px;color:#949ba4;">Aujourd'hui à <%= new Date().toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'}) %></div>
        </div>
      </div>
      <div class="embed-preview" id="live-preview" style="border-left-color:#e2c97e;">
        <img class="ep-thumbnail" id="prev-thumb">
        <div class="ep-author" id="prev-author" style="display:none">
          <div class="ep-author-icon"></div>
          <div class="ep-author-name" id="prev-author-name"></div>
        </div>
        <div class="ep-title" id="prev-title" style="display:none"></div>
        <div class="ep-desc" id="prev-desc">La description de l'embed apparaîtra ici...</div>
        <div class="ep-fields" id="prev-fields"></div>
        <img class="ep-image" id="prev-image">
        <div class="ep-footer" id="prev-footer" style="display:none">
          <img id="prev-footer-icon" src="" style="display:none;">
          <span id="prev-footer-text"></span>
        </div>
      </div>
      <div class="buttons-preview" id="prev-buttons"></div>
    </div>
  </div>

</div>
</div>

<!-- TAB SAUVEGARDÉS -->
<div class="tab-content" id="tab-saved">
  <% if (!savedEmbeds || savedEmbeds.length === 0) { %>
    <div style="text-align:center;padding:40px;color:var(--text-muted);">
      <div style="font-size:32px;margin-bottom:8px;">📭</div>
      <div>Aucun embed sauvegardé pour l'instant.</div>
      <div style="font-size:12px;margin-top:6px;">Créez votre premier embed dans l'onglet "Créer un embed".</div>
    </div>
  <% } else { %>
    <div class="saved-list">
      <% savedEmbeds.forEach(e => { %>
        <div class="saved-item">
          <div class="saved-item-info">
            <div class="saved-item-name">📄 <%= e.name %></div>
            <div class="saved-item-channel">#<%= textChannels.find(c=>c.id===e.channelId)?.name || 'salon inconnu' %> • <%= new Date(e.createdAt).toLocaleDateString('fr-FR') %></div>
          </div>
          <div class="saved-item-actions">
            <button class="btn btn-sm" style="background:var(--elevated);color:var(--text);" onclick="loadEmbed(<%= JSON.stringify(e) %>)">✏️ Modifier</button>
            <form method="POST" action="/dashboard/<%= guild.id %>/embeds" style="display:inline;">
              <input type="hidden" name="section" value="resend">
              <input type="hidden" name="embedId" value="<%= e._id %>">
              <select name="targetChannel" style="font-size:12px;padding:4px 8px;height:30px;margin-right:4px;" data-channel-search data-current="<%= e.channelId || '' %>">
                <% textChannels.forEach(c => { %><option value="<%= c.id %>">#<%= c.name %></option><% }) %>
              </select>
              <button type="submit" class="btn btn-sm btn-gold">📨 Renvoyer</button>
            </form>
            <form method="POST" action="/dashboard/<%= guild.id %>/embeds" style="display:inline;" onsubmit="return confirm('Supprimer cet embed ?')">
              <input type="hidden" name="section" value="delete">
              <input type="hidden" name="embedId" value="<%= e._id %>">
              <button type="submit" class="btn btn-sm" style="background:#da373c;color:#fff;">🗑️</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
// ─── Tab switching ───────────────────────────────────────────────
function switchTab(name) {
  document.querySelectorAll('.tab').forEach((t,i) => t.classList.toggle('active', ['create','saved'][i]===name));
  document.querySelectorAll('.tab-content').forEach((t,i) => t.classList.toggle('active', ['tab-create','tab-saved'][i]==='tab-'+name));
}

// ─── Live preview ────────────────────────────────────────────────
function updatePreview() {
  const color  = document.getElementById('embedColor').value || '#5865f2';
  const author = document.getElementById('embedAuthor').value;
  const title  = document.getElementById('embedTitle').value;
  const desc   = document.getElementById('embedDesc').value;
  const image  = document.getElementById('embedImage').value;
  const thumb  = document.getElementById('embedThumb').value;
  const footer = document.getElementById('embedFooter').value;
  const footerIcon = document.getElementById('embedFooterIcon').value;

  const preview = document.getElementById('live-preview');
  if (/^#[0-9A-Fa-f]{6}$/.test(color)) preview.style.borderLeftColor = color;

  const authorEl = document.getElementById('prev-author');
  const authorName = document.getElementById('prev-author-name');
  authorEl.style.display = author ? 'flex' : 'none';
  authorName.textContent = author;

  const titleEl = document.getElementById('prev-title');
  titleEl.style.display = title ? 'block' : 'none';
  titleEl.textContent = title;

  document.getElementById('prev-desc').textContent = desc || 'La description de l\'embed apparaîtra ici...';

  const imgEl = document.getElementById('prev-image');
  imgEl.src = image; imgEl.style.display = image ? 'block' : 'none';

  const thumbEl = document.getElementById('prev-thumb');
  thumbEl.src = thumb; thumbEl.style.display = thumb ? 'block' : 'none';

  const footerEl = document.getElementById('prev-footer');
  footerEl.style.display = footer ? 'flex' : 'none';
  document.getElementById('prev-footer-text').textContent = footer;
  const fiEl = document.getElementById('prev-footer-icon');
  fiEl.src = footerIcon; fiEl.style.display = footerIcon ? 'inline' : 'none';

  renderFieldsPreview();
  renderButtonsPreview();
}

// ─── Fields ──────────────────────────────────────────────────────
let fields = [];
function addField(name='', value='', inline=false) {
  const idx = fields.length;
  fields.push({ name, value, inline });
  const c = document.getElementById('fields-container');
  const div = document.createElement('div');
  div.className = 'field-row'; div.dataset.idx = idx;
  div.innerHTML = `
    <input type="text" placeholder="Nom du champ" value="${name}" oninput="fields[${idx}].name=this.value;updatePreview()">
    <input type="text" placeholder="Valeur" value="${value}" oninput="fields[${idx}].value=this.value;updatePreview()">
    <label style="font-size:12px;color:var(--text-muted);white-space:nowrap;display:flex;align-items:center;gap:4px;">
      <input type="checkbox" ${inline?'checked':''} onchange="fields[${idx}].inline=this.checked;updatePreview()"> Inline
    </label>
    <button type="button" class="btn-icon" onclick="removeField(${idx})">✕</button>`;
  c.appendChild(div);
  updatePreview();
}
function removeField(idx) {
  fields[idx] = null;
  document.querySelector(`[data-idx="${idx}"]`).remove();
  updatePreview();
}
function renderFieldsPreview() {
  const c = document.getElementById('prev-fields');
  const active = fields.filter(Boolean);
  c.style.gridTemplateColumns = active.some(f=>f.inline) ? '1fr 1fr' : '1fr';
  c.innerHTML = active.map(f => `
    <div class="ep-field" style="${f.inline?'':'grid-column:1/-1'}">
      <div class="ep-field-name">${f.name||'Champ'}</div>
      <div class="ep-field-value">${f.value||'Valeur'}</div>
    </div>`).join('');
}

// ─── Buttons ─────────────────────────────────────────────────────
let buttons = [];
const BTN_STYLES = { primary:'Bleu', secondary:'Gris', success:'Vert', danger:'Rouge', link:'Lien URL' };
function addButton(label='', style='primary', url='') {
  const idx = buttons.length;
  buttons.push({ label, style, url });
  const c = document.getElementById('buttons-container');
  const div = document.createElement('div');
  div.className = 'field-row'; div.dataset.bidx = idx;
  div.innerHTML = `
    <input type="text" placeholder="Texte du bouton" value="${label}" oninput="buttons[${idx}].label=this.value;updatePreview()">
    <select onchange="buttons[${idx}].style=this.value;updatePreview()">
      ${Object.entries(BTN_STYLES).map(([k,v])=>`<option value="${k}" ${style===k?'selected':''}>${v}</option>`).join('')}
    </select>
    <input type="url" placeholder="URL (si lien)" value="${url}" oninput="buttons[${idx}].url=this.value" style="max-width:160px;">
    <button type="button" class="btn-icon" onclick="removeButton(${idx})">✕</button>`;
  c.appendChild(div);
  updatePreview();
}
function removeButton(idx) {
  buttons[idx] = null;
  document.querySelector(`[data-bidx="${idx}"]`).remove();
  updatePreview();
}
function renderButtonsPreview() {
  const c = document.getElementById('prev-buttons');
  c.innerHTML = buttons.filter(Boolean).map(b => `<div class="btn-discord ${b.style}">${b.label||'Bouton'}</div>`).join('');
}

// ─── Pack data before submit ──────────────────────────────────────
function packData() {
  document.getElementById('fieldsData').value  = JSON.stringify(fields.filter(Boolean));
  document.getElementById('buttonsData').value = JSON.stringify(buttons.filter(Boolean));
}

// ─── Load saved embed into editor ────────────────────────────────
function loadEmbed(e) {
  switchTab('create');
  document.getElementById('embedId').value     = e._id || '';
  document.getElementById('embedName').value   = e.name || '';
  document.getElementById('embedChannel').value= e.channelId || '';
  document.getElementById('embedColor').value  = e.color || '#e2c97e';
  document.getElementById('embedAuthor').value = e.author || '';
  document.getElementById('embedTitle').value  = e.title || '';
  document.getElementById('embedDesc').value   = e.description || '';
  document.getElementById('embedImage').value  = e.image || '';
  document.getElementById('embedThumb').value  = e.thumbnail || '';
  document.getElementById('embedFooter').value = e.footer || '';
  document.getElementById('embedFooterIcon').value = e.footerIcon || '';
  // Reload fields & buttons
  fields = []; buttons = [];
  document.getElementById('fields-container').innerHTML = '';
  document.getElementById('buttons-container').innerHTML = '';
  (e.fields||[]).forEach(f => addField(f.name, f.value, f.inline));
  (e.buttons||[]).forEach(b => addButton(b.label, b.style, b.url));
  updatePreview();
  window.scrollTo({top:0, behavior:'smooth'});
}

updatePreview();
</script>

<%- include('../partials/footer') %>
