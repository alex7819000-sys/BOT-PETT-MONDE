<%- include('../partials/header', {pageTitle: 'Pubs & Partenariats', pageDesc: 'Catalogue des publicités planifiées', saved: saved}) %>

<div class="section-title">➕ Créer une publicité</div>
<form method="POST" action="/dashboard/<%= guild.id %>/pubs/create" style="margin-bottom:34px;">
  <div class="form-row">
    <div class="form-group">
      <label class="field-label">Titre</label>
      <input type="text" name="title" placeholder="Ex: Partenariat avec Le Royaume">
    </div>
    <div class="form-group">
      <label class="field-label">Lien (optionnel)</label>
      <input type="url" name="link" placeholder="https://discord.gg/...">
    </div>
  </div>
  <div class="form-group">
    <label class="field-label">Texte de la publicité</label>
    <textarea name="text" required placeholder="Contenu du message qui sera publié…"></textarea>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label class="field-label">Type de planification</label>
      <select name="scheduleType">
        <option value="interval">Toutes les X minutes</option>
        <option value="daily">Une fois par jour, à une heure fixe</option>
      </select>
    </div>
    <div class="form-group">
      <label class="field-label">Intervalle (minutes) — si "Toutes les X minutes"</label>
      <input type="number" name="intervalMinutes" value="60">
    </div>
  </div>
  <div class="form-group" style="max-width:200px;">
    <label class="field-label">Heure quotidienne (0-23) — si "Une fois par jour"</label>
    <input type="number" name="dailyHour" value="20" min="0" max="23">
  </div>
  <button type="submit" class="btn btn-gold">➕ Créer la publicité</button>
</form>

<div class="section-title">📣 Catalogue (<%= pubs.length %>)</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>Titre</th><th>Planification</th><th>Statut</th><th>Dernier envoi</th><th></th></tr></thead>
    <tbody>
      <% if (pubs.length === 0) { %><tr><td colspan="5" class="empty-row">Aucune publicité créée.</td></tr><% } %>
      <% pubs.forEach(p => { %>
        <tr>
          <td><%= p.title || '(sans titre)' %></td>
          <td><%= p.scheduleType === 'daily' ? `Quotidien à ${p.dailyHour}h` : `Toutes les ${p.intervalMinutes} min` %></td>
          <td><span class="badge <%= p.active ? 'badge-sage' : '' %>" <%- !p.active ? 'style="background:var(--elevated);color:var(--text-dim);"' : '' %>><%= p.active ? 'Active' : 'Inactive' %></span></td>
          <td><%= p.lastSent ? new Date(p.lastSent).toLocaleString('fr-FR') : 'Jamais' %></td>
          <td style="display:flex;gap:6px;">
            <form method="POST" action="/dashboard/<%= guild.id %>/pubs/<%= p.pubId %>/toggle">
              <button type="submit" class="btn btn-sm btn-ghost"><%= p.active ? 'Désactiver' : 'Activer' %></button>
            </form>
            <form method="POST" action="/dashboard/<%= guild.id %>/pubs/<%= p.pubId %>/delete" data-confirm="Supprimer cette publicité ?">
              <button type="submit" class="btn btn-sm btn-garnet">Suppr.</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
