<%- include('../partials/header', {pageTitle: 'Overview', pageDesc: 'Vue d\'ensemble de l\'activité du serveur'}) %>

<div data-autorefresh="30000"></div>

<div class="grid grid-4">
  <div class="card stat-card">
    <div class="label">Membres trackés</div>
    <div class="value"><%= totalUsers.toLocaleString('fr-FR') %></div>
    <div class="hint">Profils XP en base</div>
  </div>
  <div class="card stat-card">
    <div class="label">Messages aujourd'hui</div>
    <div class="value gold"><%= messagesToday.toLocaleString('fr-FR') %></div>
    <div class="hint">Tous salons confondus</div>
  </div>
  <div class="card stat-card">
    <div class="label">Tickets ouverts</div>
    <div class="value <%= ticketsOpen > 0 ? 'garnet' : '' %>"><%= ticketsOpen %></div>
    <div class="hint">En attente de traitement</div>
  </div>
  <div class="card stat-card">
    <div class="label">Avertissements actifs</div>
    <div class="value <%= warnsActive > 0 ? 'garnet' : 'sage' %>"><%= warnsActive %></div>
    <div class="hint">Non supprimés</div>
  </div>
</div>

<div class="section-title">🔢 Counting</div>
<div class="grid grid-3">
  <div class="card stat-card">
    <div class="label">Compte actuel</div>
    <div class="value gold"><%= cfg.countingCurrent || 0 %></div>
  </div>
  <div class="card stat-card">
    <div class="label">Meilleur streak</div>
    <div class="value sage"><%= cfg.countingBestStreak || 0 %></div>
  </div>
  <div class="card stat-card">
    <div class="label">Pires comptables</div>
    <div class="hint" style="margin-top:2px;">
      <% if (countingTop.length === 0) { %>Aucune erreur enregistrée 🎉<% } %>
      <% countingTop.forEach(o => { %>
        <div class="user-cell" style="margin-top:6px;"><%= o.userId %> — <span class="badge badge-garnet"><%= o.errorCount %> err.</span></div>
      <% }) %>
    </div>
  </div>
</div>

<div class="form-row" style="margin-top:30px;">
  <div>
    <div class="section-title">🏆 Top XP</div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>#</th><th>Membre</th><th>Niveau</th><th>XP total</th></tr></thead>
        <tbody>
          <% if (topUsers.length === 0) { %><tr><td colspan="4" class="empty-row">Aucune donnée XP encore.</td></tr><% } %>
          <% topUsers.forEach((u, i) => { %>
            <tr>
              <td class="rank-pos">#<%= i + 1 %></td>
              <td class="user-cell"><%= u.username || u.userId %></td>
              <td><%= u.level %></td>
              <td><%= u.totalXp.toLocaleString('fr-FR') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div>
    <div class="section-title">🛡️ Derniers avertissements</div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Membre</th><th>Raison</th><th>#</th></tr></thead>
        <tbody>
          <% if (recentWarns.length === 0) { %><tr><td colspan="3" class="empty-row">Aucun avertissement.</td></tr><% } %>
          <% recentWarns.forEach(w => { %>
            <tr>
              <td class="user-cell"><%= w.userId %></td>
              <td><%= w.reason.length > 30 ? w.reason.slice(0,30) + '…' : w.reason %></td>
              <td><span class="badge badge-garnet">#<%= w.warnNumber %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="section-title">🎫 Derniers tickets</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>Membre</th><th>Type</th><th>Statut</th></tr></thead>
    <tbody>
      <% if (recentTickets.length === 0) { %><tr><td colspan="3" class="empty-row">Aucun ticket.</td></tr><% } %>
      <% recentTickets.forEach(t => { %>
        <tr>
          <td class="user-cell"><%= t.userId %></td>
          <td><%= t.type %></td>
          <td><span class="badge <%= t.status === 'open' ? 'badge-gold' : 'badge-sage' %>"><%= t.status === 'open' ? 'Ouvert' : 'Fermé' %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
